// audio.subl —— 音频桥（BGM 单通道循环 + 一次性音效；资产缺失静默）
//
// 资产约定（assets/ 由 build.ps1 随包）：
//   bgm —— assets/audio/<bgm id>.wav（id 含 .ogg 则原样用）：主界面 BGM_MAIN 为 TFR 主题曲 ogg 循环；
//          超事件 bgm 与模组 entities.events kind=super 的 bgm 字段同名，事件阶段结束后回到 BGM_MAIN
//   sfx —— assets/audio/sfx-<id>.wav：click / close / start / news / mov-1..8（moving 系列，移动时随机一首）
// Audio 环境缺失（Node smoke）/浏览器手势策略拦截自动播放时一律静默 false，不阻断游戏流；
// 运行时同名 BGM 去重（播放失败会置未播放，下一帧自动重试），故可逐帧调用。

// ---------- 宿主桥（@game op，无体声明） ----------
@game @host @impure fun bgmMount(name: Str): Bool
@game @host @impure fun bgmPlay(name: Str): Bool
@game @host @impure fun bgmStop(): Bool
@game @host @impure fun sndPlay(name: Str): Bool
@game @host @impure fun rndInt(lo: Nat, hi: Nat): Nat

// ---------- 曲目/音效表 ----------
fun BGM_MAIN(): Str = "bgm-main.ogg"  // 主界面 BGM：TFR 主题曲 TheFireRisesMainTheme（循环）
fun sfxFile(id: Str): Str = concat("assets/audio/sfx-", concat(id, ".wav"))
fun bgmFile(id: Str): Str = concat("assets/audio/", (if (strHas(id, ".ogg")) id else concat(id, ".wav")))

// 按 bgm id 播放（同曲逐帧调用安全；失败静默）。
@impure
fun bgmPlayId(id: Str): Bool {
    var f: Str = bgmFile(id)
    return if (strCmp(f, "") == 0) bgmStop() else bgmPlay(f)
}

// 按 sfx id 播一次性音效（click/close/start/news）

// 军队移动音效：moving 系列（TFR prc_Moving）随机一首，播放一次、不循环
fun MOV_N(): Nat = 8
@impure
fun sfxPlayMove(): Bool {
    var k: Nat = rndInt(1, MOV_N())
    return sfxPlay(concat("mov-", toStr(k)))
}
@impure
fun sfxPlay(id: Str): Bool {
    return sndPlay(sfxFile(id))
}
