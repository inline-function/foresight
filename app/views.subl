// views.subl —— 叙事演出层（t89：1920x1080 MD3 Dialog/Card 风格）
// 事件卡 = MD3 对话框（scrim + 圆角表面 + 标题/内容 + MD3 按钮选项）；
// 沉浸式 = 三要素（默认背景图 + 人物名 + 对话内容，无名=旁白）；超事件 = 黑底逐行。
// 三种层的内容全部来自模组 entities.events，本体只提供几何与缺图占位渲染。
// tag="view"（z 26-100）：事件层高于全屏界面(30)，超事件全屏高于一切。
@impure
fun bgmHookOf(name: Str): Null = null

// ---------- 演出层几何（x2） ----------
fun CC_X(): Rat = 480.0
fun CC_W(): Rat = 960.0
fun CC_Y(): Rat = 220.0
fun CC_H(): Rat = 660.0
fun CC_OPT_Y0(): Rat = 496.0
fun CC_OPT_DY(): Rat = 84.0
fun CC_OPT_H(): Rat = 72.0
fun CC_RAD(): Rat = 56.0
fun COL_CARD(): Str = "#2A2F35"
fun COL_FRAME(): Str = "#8B939C"
fun COL_INNER(): Str = "#171A1D"
fun COL_SOFT(): Str = "#E4E7EA"
fun COL_DIM(): Str = "#0B1016"
fun COL_BLACK(): Str = "#000000"

// ---------- 总分发 ----------
@impure
fun renderView(m: Json, ev: Json, step: Nat): Null {
    var kind: Str = jstr(ev, "kind")
    if (strCmp(kind, "card") == 0) renderEventCard(m, ev, step)
    else (if (strCmp(kind, "imm") == 0) renderImmersive(m, ev, step)
    else (if (strCmp(kind, "super") == 0) renderSuper(m, ev, step) else renderEventCard(m, ev, step)))
    null
}

// ---------- 事件卡：MD3 Dialog（scrim + 圆角表面 + 标题 + 内容 + 按钮组） ----------
@impure
fun renderEventCard(m: Json, ev: Json, step: Nat): Null {
    var o: Any = addRectT(1920.0, 1080.0, 0.0, 0.0, COL_DIM(), "view", 26.0)
    var o2: Any = addRoundRect(CC_W(), CC_H(), CC_X(), CC_Y(), COL_CARD(), "view", 30.0, CC_RAD())
    var tt: Any = addTextT(jstr(ev, "title"), (CC_X() + 48.0), (CC_Y() + 40.0), 40.0, 700, COL_SOFT(), "view", true, 32.0)
    var ct: Any = addTextWrap(jstr(ev, "content"), (CC_X() + 48.0), (CC_Y() + 108.0), 28.0, 400, (CC_W() - 96.0), COL_SOFT(), "view", true, 32.0)
    renderCardOptLoop(m, jk(ev, "options"), 0, arrLen(jk(ev, "options")))
    null
}
@impure
fun renderCardOptLoop(m: Json, opts: Json, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var nm: Str = jstr(arrAt(opts, i), "name")
        var y: Rat = (CC_OPT_Y0() + (CC_OPT_DY() * toRat(i)))
        // MD3 按钮混排：主选项 filled（Primary）/ 其余 tonal（Surface Container Highest）
        var btn: Any = addRoundRect((CC_W() - 96.0), CC_OPT_H(), (CC_X() + 48.0), y, if (i == 0) "#A6C8FF" else "#363B42", "view", 31.0, 20.0)
        var ot: Any = addTextT(nm, (CC_X() + 80.0), (y + 20.0), 26.0, 600, if (i == 0) "#05243F" else COL_SOFT(), "view", true, 32.0)
        renderCardOptLoop(m, opts, (i + 1), n)
    }
@impure
fun cardRowHitLoop(y: Rat, dy: Rat, my: Rat, i: Nat, n: Nat): Nat =
    if (i >= n) n
    else (if ((my >= y) && (my < (y + dy))) i else cardRowHitLoop((y + dy), dy, my, (i + 1), n))
@impure
fun cardRowHit(my: Rat, n: Nat): Nat = cardRowHitLoop(CC_OPT_Y0(), CC_OPT_DY(), my, 0, n)

// ---------- 沉浸式：MD3 全屏对话框（背景/立绘占位 + 逐行对话） ----------
// ---------- 沉浸式（三要素）：背景图（默认占位）+ 人物名（旁白无）+ 对话内容 ----------
// 布局：全屏默认背景（无美术资源时的统一底图）+ 底部 VN 式对话框 + 框上人物名牌；
// 人物名为空（None/缺省）= 旁白，不画名牌，对话内容直接呈现在框内。
fun IM_BG0(): Str = "#14181C"
fun IM_BG1(): Str = "#1B2026"
fun IM_SCENE_Y(): Rat = 56.0
fun IM_SCENE_H(): Rat = 880.0
fun IM_DLG_Y(): Rat = 768.0
fun IM_DLG_H(): Rat = 232.0
fun IM_NAME_Y(): Rat = 688.0
fun IM_NAME_H(): Rat = 64.0
fun IM_PAD(): Rat = 80.0
@impure
fun renderImmersive(m: Json, ev: Json, step: Nat): Null {
    var linesJ: Json = jk(ev, "lines")
    var line: Json = arrAt(linesJ, step)
    var nm: Str = lineNameOf(line)
    var tx: Str = lineTextOf1(line)
    // 1) 背景图：默认背景（资源管线未通前统一底图：深色场景面 + 顶部场景小标）
    var b0: Any = addRectT(1920.0, 1080.0, 0.0, 0.0, IM_BG0(), "view", 26.0)
    var b1: Any = addRoundRect(1760.0, IM_SCENE_H(), IM_PAD(), IM_SCENE_Y(), IM_BG1(), "view", 27.0, 32.0)
    var st: Any = addTextT(jstr(ev, "title"), (IM_PAD() + 48.0), (IM_SCENE_Y() + 32.0), 24.0, 400, "#8B939C", "view", true, 27.0)
    // 2) 对话内容：底部 VN 式对话框（逐行 step 推进）
    var db: Any = addRoundRect(1760.0, IM_DLG_H(), IM_PAD(), IM_DLG_Y(), COL_CARD(), "view", 28.0, 28.0)
    var lt: Any = addTextWrap(tx, (IM_PAD() + 64.0), (IM_DLG_Y() + 44.0), 34.0, 400, 1632.0, COL_SOFT(), "view", true, 30.0)
    var ht: Any = addTextT(lineHint(step, arrLen(linesJ)), (IM_PAD() + 64.0), (IM_DLG_Y() + 160.0), 22.0, 400, "#8B939C", "view", true, 30.0)
    // 3) 人物名：非空才画（MD3 名牌）
    if (strCmp(nm, "") != 0) {
        var nb: Any = addRoundRect(336.0, IM_NAME_H(), IM_PAD(), IM_NAME_Y(), "#A6C8FF", "view", 28.0, 20.0)
        var nt: Any = addTextT(nm, (IM_PAD() + 32.0), (IM_NAME_Y() + 14.0), 30.0, 700, "#05243F", "view", true, 32.0)
    } else null
    null
}
// 行解析：对象行 {name, text}（name 缺省/空 = 旁白）；纯文本旧行兜底（无名字）
@impure
fun lineNameOf(line: Json): Str = jstr(line, "name")
@impure
fun lineTextOf(lines: Json, i: Nat): Str = lineTextOf1(arrAt(lines, i))
@impure
fun lineTextOf1(line: Json): Str = if (strCmp(jstr(line, "text"), "") != 0) jstr(line, "text") else strOr(jsonStr(line), "")
@impure
fun lineHint(step: Nat, cnt: Nat): Str =
    if (step + 1 >= cnt) "点击结束" else "点击继续"

// ---------- 超事件：全屏黑底 + 逐行 + BGM 挂载点（资产缺失静默） ----------
@impure
fun renderSuper(m: Json, ev: Json, step: Nat): Null {
    bgmHookOf(jstr(ev, "bgm"))
    var bk: Any = addRectT(1920.0, 1080.0, 0.0, 0.0, COL_BLACK(), "view", 100.0)
    var tt: Any = addTextC(jstr(ev, "title"), 960.0, 300.0, 44.0, COL_SOFT(), "view", true, 100.0)
    var lt: Any = addTextC(lineTextOf(jk(ev, "lines"), step), 960.0, 480.0, 46.0, COL_SOFT(), "view", true, 100.0)
    var ht: Any = addTextC(lineHint(step, arrLen(jk(ev, "lines"))), 960.0, 600.0, 26.0, COL_SOFT(), "view", true, 100.0)
    null
}

// ---------- 章末演出（与超事件同构；行来自章节 end.lines 数组） ----------
@impure
fun renderChEnd(m: Json, lines: Json, step: Nat): Null {
    var bk: Any = addRectT(1920.0, 1080.0, 0.0, 0.0, COL_BLACK(), "view", 100.0)
    var lt: Any = addTextT(lineTextOf(lines, step), 280.0, 480.0, 46.0, 400, COL_SOFT(), "view", true, 100.0)
    var ht: Any = addTextT(lineHint(step, arrLen(lines)), 280.0, 600.0, 26.0, 400, COL_SOFT(), "view", true, 100.0)
    null
}
