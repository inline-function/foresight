// topbar.subl —— 顶栏（国家主标题全不透明 + 派系副标题弱透明 + 右侧日期与资源，全部由引擎状态驱动）
// 日期 = 引擎 tick（1 tick = 1 天）按天推进；资源行 = entities.resources 的即时值；
// 时间标签与资源标签独立 tag（refreshTopbar 原位重建）。
fun TITLE_H(): Rat = 46.0
fun TBAR_HEX(): Str = "#1B2430"
fun SUB_HEX(): Str = "#8FA3B8"
fun RES_HEX(): Str = "#9FB3C7"

@impure
fun buildTopbar(m: Json, s: Str): Null {
    var md: Json = modMod(m)
    var ent: Json = modEnt(m)
    var bar: Any = addRectT(960.0, TITLE_H(), 0.0, 0.0, TBAR_HEX(), "ui", 10.0)
    var tt: Any = addTextT(playerCountry(md), 14.0, 5.0, 17.0, 700, "#F0F4F8", "ui", true, 11.0)
    var ft: Any = addTextT(factionName(ent, playerFactionId(md)), 14.0, 26.0, 12.0, 400, SUB_HEX(), "ui", true, 11.0)
    refreshTopbar(m, s)
    null
}

// 顶栏右半：日期（era 前缀 + 年月日，无回合数）与资源行，随引擎状态刷新
@impure
fun refreshTopbar(m: Json, s: Str): Null {
    objsDestroyTag("ui-time")
    objsDestroyTag("ui-res")
    var md: Json = modMod(m)
    var dt: Str = dateText(engNum(s, F_Y()), engNum(s, F_M()), engNum(s, F_D()))
    var tt: Str = if (strCmp(timeEra(md), "") == 0) dt else concat(concat(timeEra(md), " · "), dt)
    var t1: Any = addTextT(tt, 700.0, 9.0, 15.0, 400, SUB_HEX(), "ui-time", true, 12.0)
    var t2: Any = addTextT(resLineText(m, s), 175.0, 28.0, 12.0, 400, RES_HEX(), "ui-res", true, 12.0)
    null
}

// 资源行（至多前 3 项：name val，· 分隔）
@impure
fun resLineLoop(m: Json, s: Str, i: Nat, n: Nat, acc: Str): Str =
    if ((i >= n) || (i >= 3)) acc
    else {
        var part: Str = concat(concat(resName(modEnt(m), i), " "), toStr(resStrGet(engField(s, F_RES()), i)))
        resLineLoop(m, s, (i + 1), n, if (i == 0) part else concat(concat(acc, " · "), part))
    }
@impure
fun resLineText(m: Json, s: Str): Str = resLineLoop(m, s, 0, resCount(modEnt(m)), "")
