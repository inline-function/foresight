// topbar.subl —— MD3 Top App Bar（t89：1920x1080，深色 tonal 色板）
// 国家主标题（onSurface）+ 派系副标题（onSurfaceVariant）+ 右侧日期 + 资源 chips
// 全部由引擎状态驱动；chips = entities.resources 前 3 项（name val）。
fun TITLE_H(): Rat = 88.0
fun TOP_TITLE_X(): Rat = 32.0
fun CHIP_X0(): Rat = 560.0
fun CHIP_W(): Rat = 148.0
fun CHIP_DY(): Rat = 160.0
fun DATE_CX(): Rat = 1780.0
fun TBAR_HEX(): Str = "#1F2327"
fun SUB_HEX(): Str = "#B7BFC8"
fun RES_HEX(): Str = "#E4E7EA"
fun CHIP_HEX(): Str = "#2A2F35"

@impure
fun buildTopbar(m: Json, s: Str): Null {
    var md: Json = modMod(m)
    var ent: Json = modEnt(m)
    var bar: Any = addRectT(VIEW_W(), TITLE_H(), 0.0, 0.0, TBAR_HEX(), "ui", 10.0)
    var tt: Any = addTextT(playerCountry(md), TOP_TITLE_X(), 10.0, 34.0, 700, COL_TITLE(), "ui", true, 12.0)
    var ft: Any = addTextT(factionName(ent, playerFactionId(md)), TOP_TITLE_X(), 54.0, 20.0, 400, SUB_HEX(), "ui", true, 12.0)
    refreshTopbar(m, s)
    null
}

// 顶栏右半：日期（era 前缀 + 年月日）与资源 chips，随引擎状态刷新
@impure
fun refreshTopbar(m: Json, s: Str): Null {
    objsDestroyTag("ui-time")
    objsDestroyTag("ui-res")
    var md: Json = modMod(m)
    var dt: Str = dateText(engNum(s, F_Y()), engNum(s, F_M()), engNum(s, F_D()))
    var tt: Str = if (strCmp(timeEra(md), "") == 0) dt else concat(concat(timeEra(md), " · "), dt)
    var t1: Any = addTextC(tt, DATE_CX(), 44.0, 24.0, SUB_HEX(), "ui-time", true, 12.0)
    null
}

// 资源 chips（前 3 项：MD3 pill = 圆角容器 + 居中文本）
@impure
fun resChipLoop(m: Json, s: Str, i: Nat, n: Nat): Null =
    if ((i >= n) || (i >= resCount(modEnt(m)))) null
    else {
        var cx: Rat = (CHIP_X0() + (CHIP_DY() * toRat(i)))
        var body: Any = addRoundRect(CHIP_W(), 48.0, cx, 20.0, CHIP_HEX(), "ui-res", 12.0, 20.0)
        var tx: Any = addTextC(concat(concat(resName(modEnt(m), i), " "), toStr(resStrGet(engField(s, F_RES()), i))), (cx + (CHIP_W() / 2.0)), 44.0, 18.0, RES_HEX(), "ui-res", true, 13.0)
        resChipLoop(m, s, (i + 1), n)
    }
