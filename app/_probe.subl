// 探针：嵌套函数改写外层 @mut + 互递归前向引用（t86 引擎状态机依赖）
@impure
fun probeMain(): Str {
    var phase: Str = "idle"
    var n: Nat = 0
    @impure
    fun stepA(): Null {
        n = n + 1
        if (n < 3) stepB() else null
    }
    @impure
    fun stepB(): Null {
        n = n + 10
        phase = "done"
        if (n < 20) stepA() else null
    }
    stepA()
    phase
}
