// bottombar.subl —— MD3 Navigation Bar + 全屏界面（t89：1920x1080）
// 队长裁决 6.1：底栏「操作/国策/国家属性/控制地块」= 全屏界面切换（覆盖画布、留底栏导航），
// 每个全屏界面左上角「‹ 返回地图」按钮回主界面；事件层（z>30）仍盖其上。
// 本体只提供 MD3 视觉框架与几何；文案/图标由模组 entities.ui 配（图标由本体按 kind 过程化绘制）。

// ---------- 几何（世界坐标，整体 x2） ----------
fun NAV_Y(): Rat = 1008.0
fun NAV_H(): Rat = 72.0
fun NAV_W(): Rat = 480.0
fun BTN_Y(): Rat = NAV_Y()
fun BTN_W(): Rat = NAV_W()
fun BTN_H(): Rat = NAV_H()
fun BTN_N(): Nat = 4
fun FS_W(): Rat = 1920.0
fun FS_H(): Rat = 1008.0
fun BACK_X(): Rat = 32.0
fun BACK_Y(): Rat = 32.0
fun BACK_W(): Rat = 240.0
fun BACK_H(): Rat = 64.0
fun TITLE_X(): Rat = 320.0
fun TITLE_Y(): Rat = 44.0
fun STRIP_Y(): Rat = 128.0
fun ROW_X(): Rat = 64.0
fun ROW_W(): Rat = 1792.0
fun ROW_Y0(): Rat = 160.0
fun ROW_DY(): Rat = 112.0
fun ROW_H(): Rat = 88.0

// ---------- MD3 深色 tonal 色板 ----------
fun FS_HEX(): Str = "#1F2327"
fun ROW_HEX(): Str = "#2A2F35"
fun ROW_SEL(): Str = "#363B42"
fun TXT_HEX(): Str = "#E4E7EA"
fun TXT_VAR(): Str = "#B7BFC8"
fun NAV_HEX(): Str = "#1F2327"
fun PRIMARY_HEX(): Str = "#A6C8FF"
fun ON_PRIMARY(): Str = "#05243F"
fun STATE_HEX(): Str = "#444B52"
fun COL_SKIP(): Str = "#C8A24B"

fun btnX(i: Nat): Rat = (NAV_W() * toRat(i))
fun btnKind(i: Nat): Str = if (i == 0) "ops" else (if (i == 1) "policy" else (if (i == 2) "attrs" else "blocks"))
@impure
fun btnLabel(m: Json, i: Nat): Str =
    if (i == 0) uiOps(modEnt(m))
    else (if (i == 1) uiPolicy(modEnt(m)) else (if (i == 2) uiAttrs(modEnt(m)) else uiBlocks(modEnt(m))))
fun btnHit(mx: Rat, my: Rat, i: Nat): Bool =
    if ((mx >= btnX(i)) && (mx <= (btnX(i) + BTN_W()))) ((my >= NAV_Y()) && (my <= (NAV_Y() + NAV_H()))) else false
@impure
fun whichBtnLoop(mx: Rat, my: Rat, i: Nat, n: Nat): Nat =
    if (i >= n) n else (if (btnHit(mx, my, i)) i else whichBtnLoop(mx, my, (i + 1), n))
@impure
fun whichBtn(mx: Rat, my: Rat): Nat = whichBtnLoop(mx, my, 0, BTN_N())

// ---------- MD3 Navigation Bar：底栏 + 4 项（过程化图标 + 文字 + 选中态高亮） ----------
@impure
fun buildBottombar(m: Json): Null { buildNav(m, "none"); null }
@impure
fun buildNav(m: Json, panel: Str): Null {
    objsDestroyTag("ui-nav")
    var bar: Any = addRectT(FS_W(), NAV_H(), 0.0, NAV_Y(), NAV_HEX(), "ui-nav", 10.0)
    buildNavItems(m, panel, 0, BTN_N())
    null
}
@impure
fun buildNavItems(m: Json, panel: Str, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var cx: Rat = (btnX(i) + (BTN_W() / 2.0))
        var sel: Bool = (strCmp(btnKind(i), panel) == 0)
        var col: Str = if (sel) PRIMARY_HEX() else TXT_VAR()
        var lc: Str = if (sel) TXT_HEX() else TXT_VAR()
        if (sel) {
            var ind: Any = addRoundRect(96.0, 40.0, (cx - 48.0), 1012.0, ROW_SEL(), "ui-nav", 13.0, 16.0)
        } else null
        drawNavIcon(i, cx, col)
        var bt: Any = addTextT(btnLabel(m, i), (cx - 60.0), 1058.0, 18.0, 400, lc, "ui-nav", true, 14.0)
        buildNavItems(m, panel, (i + 1), n)
    }
// 四类过程化图标（rect 拼接；选中态=Primary 色 + 指示器）
@impure
fun drawNavIcon(i: Nat, cx: Rat, col: Str): Null {
    if (i == 0) {
        var a1: Any = addRectT(14.0, 14.0, (cx - 21.0), 1018.0, col, "ui-nav", 14.0)
        var a2: Any = addRectT(14.0, 14.0, (cx + 7.0), 1018.0, col, "ui-nav", 14.0)
        var a3: Any = addRectT(14.0, 14.0, (cx - 21.0), 1036.0, col, "ui-nav", 14.0)
        var a4: Any = addRectT(14.0, 14.0, (cx + 7.0), 1036.0, col, "ui-nav", 14.0)
    } else { if (i == 1) {
        var b1: Any = addRectT(8.0, 12.0, (cx - 15.0), 1042.0, col, "ui-nav", 14.0)
        var b2: Any = addRectT(8.0, 26.0, (cx - 5.0), 1028.0, col, "ui-nav", 14.0)
        var b3: Any = addRectT(8.0, 40.0, (cx + 5.0), 1014.0, col, "ui-nav", 14.0)
    } else { if (i == 2) {
        var c1: Any = addRectT(30.0, 7.0, (cx - 15.0), 1018.0, col, "ui-nav", 14.0)
        var c2: Any = addRectT(30.0, 7.0, (cx - 15.0), 1032.0, col, "ui-nav", 14.0)
        var c3: Any = addRectT(30.0, 7.0, (cx - 15.0), 1046.0, col, "ui-nav", 14.0)
    } else {
        var d1: Any = addRectT(22.0, 22.0, (cx - 16.0), 1016.0, col, "ui-nav", 14.0)
        var d2: Any = addRectT(22.0, 22.0, (cx - 4.0), 1032.0, col, "ui-nav", 14.0)
    } } }
    null
}

// ---------- 全屏界面框架（MD3：底栏之上整屏 + 左上返回按钮） ----------
@impure
fun fsFrame(kind: Str): Null {
    var bg: Any = addRectT(FS_W(), FS_H(), 0.0, 0.0, FS_HEX(), "panel", 30.0)
    var bb2: Any = addRoundRect(BACK_W(), BACK_H(), BACK_X(), BACK_Y(), ROW_SEL(), "panel", 32.0, 20.0)
    var bt: Any = addTextT("‹ 返回地图", 84.0, 50.0, 22.0, 400, TXT_HEX(), "panel", true, 33.0)
    var tt: Any = addTextT(kind, TITLE_X(), TITLE_Y(), 34.0, 700, TXT_HEX(), "panel", true, 33.0)
    null
}
@impure
fun panelBackHit(mx: Rat, my: Rat): Bool =
    if ((mx >= BACK_X()) && (mx <= (BACK_X() + BACK_W()))) ((my >= BACK_Y()) && (my <= (BACK_Y() + BACK_H()))) else false
@impure
fun panelRowHitLoop(y: Rat, dy: Rat, my: Rat, i: Nat, n: Nat): Nat =
    if (i >= n) n
    else (if ((my >= y) && (my < (y + dy))) i else panelRowHitLoop((y + dy), dy, my, (i + 1), n))
@impure
fun panelRowHit(my: Rat, n: Nat): Nat = panelRowHitLoop(ROW_Y0(), ROW_DY(), my, 0, n)
fun rowInRowX(mx: Rat): Bool = if ((mx >= ROW_X()) && (mx <= (ROW_X() + ROW_W()))) true else false

// ---------- 国策 / 属性 / 地块 全屏界面（MD3 列表） ----------
@impure
fun renderPanelKind(m: Json, s: Str, kind: Str): Str {
    var ent: Json = modEnt(m)
    objsDestroyTag("panel")
    fsFrame(if (strCmp(kind, "policy") == 0) uiPolicy(ent) else (if (strCmp(kind, "attrs") == 0) uiAttrs(ent) else uiBlocks(ent)))
    if (strCmp(kind, "policy") == 0) renderPolicyRows(m, s, 0, policyCount(ent))
    else { if (strCmp(kind, "attrs") == 0) renderAttrRows(m, s, 0, resCount(ent)) else renderBlocksRows(m, 0, blockCount(ent)) }
    return engSet(s, F_PANEL(), kind)
}
@impure
fun fsRow(i: Nat, sel: Bool): Any = addRoundRect(ROW_W(), ROW_H(), ROW_X(), (ROW_Y0() + (ROW_DY() * toRat(i))), if (sel) ROW_SEL() else ROW_HEX(), "panel", 31.0, 20.0)
@impure
fun renderAttrRows(m: Json, s: Str, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var v: Nat = resStrGet(engField(s, F_RES()), i)
        var p: Nat = resProduce(modEnt(m), i)
        var row: Any = fsRow(i, false)
        var nm: Any = addTextT(concat(resName(modEnt(m), i), toStr(v)), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 14.0), 28.0, 600, TXT_HEX(), "panel", true, 32.0)
        var sub: Any = addTextT(concat("产出 ", concat(toStr(p), "/天")), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 54.0), 20.0, 400, TXT_VAR(), "panel", true, 32.0)
        renderAttrRows(m, s, (i + 1), n)
    }
@impure
fun renderPolicyRows(m: Json, s: Str, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var ent: Json = modEnt(m)
        var acq: Bool = policyAcquired(ent, s, i)
        var mark: Str = if (acq) "已行" else (if (policyCanAcquire(ent, s, i)) "可解" else "锁定")
        var nm: Str = jstr(policyRow(ent, i), "name")
        var row: Any = fsRow(i, acq)
        var mt: Any = addTextT(concat(concat(mark, " "), nm), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 14.0), 28.0, 600, if (acq) PRIMARY_HEX() else TXT_HEX(), "panel", true, 32.0)
        var st: Any = addTextT(policyReqText(ent, i), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 54.0), 20.0, 400, TXT_VAR(), "panel", true, 32.0)
        renderPolicyRows(m, s, (i + 1), n)
    }
@impure
fun policyReqText(ent: Json, i: Nat): Str =
    if (arrLen(jk(policyRow(ent, i), "requires")) == 0) ""
    else concat("  前置：", reqNamesLoop(ent, jk(policyRow(ent, i), "requires"), 0, arrLen(jk(policyRow(ent, i), "requires")), ""))
@impure
fun reqNamesLoop(ent: Json, req: Json, i: Nat, n: Nat, acc: Str): Str =
    if (i >= n) acc
    else {
        var nm: Str = lookupName(policies(ent), strOr(jsonStr(arrAt(req, i)), ""))
        reqNamesLoop(ent, req, (i + 1), n, if (i == 0) nm else concat(concat(acc, "、"), nm))
    }
@impure
fun renderBlocksRows(m: Json, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var ent: Json = modEnt(m)
        var nm: Str = jstr(arrAt(jk(ent, "blocks"), i), "name")
        var ow: Str = countryName(ent, jstr(arrAt(jk(ent, "blocks"), i), "owner"))
        var row: Any = fsRow(i, false)
        var rt: Any = addTextT(nm, (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 14.0), 28.0, 600, TXT_HEX(), "panel", true, 32.0)
        var st: Any = addTextT(concat("归属 ", ow), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 54.0), 20.0, 400, TXT_VAR(), "panel", true, 32.0)
        renderBlocksRows(m, (i + 1), n)
    }
@impure
fun policyPanelHit(m: Json, s: Str, mx: Rat, my: Rat): Str {
    if (!rowInRowX(mx)) { return s } else null
    var n: Nat = policyCount(modEnt(m))
    var ri: Nat = panelRowHit(my, n)
    return (if (ri < n) engPolicyAcquire(m, s, ri) else s)
}

// ---------- 操作：页列表（MD3 列表 + 结束操作行） ----------
@impure
fun renderOpsMain(m: Json, s: Str): Null {
    var ent: Json = modEnt(m)
    var ci: Nat = engNum(s, F_CHAP())
    var ops: Json = chapterOps(ent, ci)
    fsFrame(opsMainTitle(ent, ci, s))
    renderOpsMainRows(m, s, 0, arrLen(ops))
    var rows: Nat = arrLen(ops)
    var row: Any = fsRow(rows, false)
    var skip: Any = addTextT("结束操作（不操作，直接结算）", (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(rows)) + 26.0), 24.0, 400, COL_SKIP(), "panel", true, 32.0)
    null
}
@impure
fun opsMainTitle(ent: Json, ci: Nat, s: Str): Str =
    concat(concat(concat(chapterAct(ent, ci), " · "), chapterName(ent, ci)), opsApText(s))
@impure
fun opsApText(s: Str): Str = concat(concat("  行动点 ", toStr(engNum(s, F_AP()))), concat(" / ", toStr(engNum(s, F_APMAX()))))
@impure
fun renderOpsMainRows(m: Json, s: Str, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var ent: Json = modEnt(m)
        var pg: Json = arrAt(chapterOps(ent, engNum(s, F_CHAP())), i)
        var row: Any = fsRow(i, false)
        var nm: Any = addTextT(jstr(pg, "name"), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 14.0), 28.0, 600, TXT_HEX(), "panel", true, 32.0)
        var ds: Any = addTextT(jstr(pg, "desc"), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 54.0), 20.0, 400, TXT_VAR(), "panel", true, 32.0)
        renderOpsMainRows(m, s, (i + 1), n)
    }

// ---------- 操作页：状态条 + radio 组选项（MD3 Button：选中=Primary filled） ----------
@impure
fun renderOpsPage(m: Json, s: Str, pid: Nat): Null {
    var ent: Json = modEnt(m)
    var ci: Nat = engNum(s, F_CHAP())
    var pg: Json = arrAt(chapterOps(ent, ci), pid)
    fsFrame(jstr(pg, "name"))
    var st1: Any = addTextT(opsStripText(m, s, pg), (ROW_X() + 4.0), STRIP_Y(), 24.0, 400, TXT_VAR(), "panel", true, 32.0)
    renderOpsPageRows(m, s, pid, pg, 0, arrLen(jk(pg, "options")))
    var rows: Nat = arrLen(jk(pg, "options"))
    var row: Any = fsRow(rows, false)
    var back: Any = addTextT("返回操作页", (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(rows)) + 26.0), 24.0, 400, TXT_VAR(), "panel", true, 32.0)
    null
}
@impure
fun opsStripText(m: Json, s: Str, pg: Json): Str {
    var ap: Str = concat(concat(concat("行动点 ", toStr(engNum(s, F_AP()))), " / "), toStr(engNum(s, F_APMAX())))
    return concat(ap, opsStatusLoop(m, s, jk(pg, "status"), 0, arrLen(jk(pg, "status")), ""))
}
@impure
fun opsStatusLoop(m: Json, s: Str, st: Json, i: Nat, n: Nat, acc: Str): Str =
    if (i >= n) acc
    else {
        var ent: Json = modEnt(m)
        var rid: Str = strOr(jsonStr(arrAt(st, i)), "")
        var part: Str = concat(concat(concat(" · ", lookupName(jk(ent, "resources"), rid)), " "), toStr(resValById(ent, s, rid)))
        opsStatusLoop(m, s, st, (i + 1), n, concat(acc, part))
    }
@impure
fun renderOpsPageRows(m: Json, s: Str, pid: Nat, pg: Json, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var opts: Json = jk(pg, "options")
        var sel: Bool = strHas(engField(s, F_SEL()), selToken(pid, i))
        var dot: Str = if (sel) "● " else "○ "
        var row: Any = fsRow(i, sel)
        var nm: Any = addTextT(concat(dot, jstr(arrAt(opts, i), "name")), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 14.0), 28.0, 600, if (sel) ON_PRIMARY() else TXT_HEX(), "panel", true, 32.0)
        var ds: Any = addTextT(jstr(arrAt(opts, i), "desc"), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 54.0), 20.0, 400, if (sel) ON_PRIMARY() else TXT_VAR(), "panel", true, 32.0)
        renderOpsPageRows(m, s, pid, pg, (i + 1), n)
    }

// ---------- 操作界面点击分派（全屏行带） ----------
@impure
fun opsPanelHit(m: Json, s: Str, mx: Rat, my: Rat): Str {
    var ent: Json = modEnt(m)
    var ops: Json = chapterOps(ent, engNum(s, F_CHAP()))
    if (!rowInRowX(mx)) { return s } else null
    if (strCmp(engField(s, F_PAGE()), "L") == 0) {
        var rows: Nat = arrLen(ops)
        var ri: Nat = panelRowHit(my, (rows + 1))
        return (if (ri < rows) engOpenOpsPage(m, s, ri) else (if (ri == rows) engOpsSkip(m, s) else s))
    } else {
        var pid: Nat = natOr(parseNat(engField(s, F_PAGE())), 0)
        var opts: Json = jk(arrAt(ops, pid), "options")
        var rows2: Nat = arrLen(opts)
        var ri2: Nat = panelRowHit(my, (rows2 + 1))
        return (if (ri2 < rows2) engOpsExec(m, s, pid, ri2) else (if (ri2 == rows2) engOpsBack(m, s) else s))
    }
}
