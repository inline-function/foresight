// bottombar.subl —— MD3 Navigation Bar + 全屏界面（t89：1920x1080）
// 队长裁决 6.1：底栏「操作/国策/国家属性/控制地块」= 全屏界面切换（覆盖画布、留底栏导航），
// 每个全屏界面左上角「‹ 返回地图」按钮回主界面；事件层（z>30）仍盖其上。
// 本体只提供 MD3 视觉框架与几何；文案/图标由模组 entities.ui 配（图标由本体按 kind 过程化绘制）。

// ---------- 几何（世界坐标，整体 x2） ----------
fun NAV_Y(): Rat = 1008.0
fun NAV_H(): Rat = 72.0
fun NAV_W(): Rat = 480.0
fun BTN_Y(): Rat = NAV_Y()
fun BTN_W(): Rat = NAV_W()
fun BTN_H(): Rat = NAV_H()
fun BTN_N(): Nat = 4
fun FS_W(): Rat = 1920.0
fun FS_H(): Rat = 1008.0
fun BACK_X(): Rat = 32.0
fun BACK_Y(): Rat = 32.0
fun BACK_W(): Rat = 240.0
fun BACK_H(): Rat = 64.0
fun TITLE_X(): Rat = 320.0
fun TITLE_Y(): Rat = 44.0
fun STRIP_Y(): Rat = 128.0
fun ROW_X(): Rat = 64.0
fun ROW_W(): Rat = 1792.0
fun ROW_Y0(): Rat = 160.0
fun ROW_DY(): Rat = 112.0
fun ROW_H(): Rat = 88.0
fun ROWS_FIT(): Nat = 7
fun rowYOf(i: Nat, off: Nat): Rat = (ROW_Y0() + (ROW_DY() * toRat((i - off))))

// ---------- MD3 深色 tonal 色板 ----------
fun FS_HEX(): Str = "#1F2327"
fun ROW_HEX(): Str = "#2A2F35"
fun ROW_SEL(): Str = "#363B42"
fun TXT_HEX(): Str = "#E4E7EA"
fun TXT_VAR(): Str = "#B7BFC8"
fun NAV_HEX(): Str = "#1F2327"
fun PRIMARY_HEX(): Str = "#A6C8FF"
fun ON_PRIMARY(): Str = "#05243F"
fun STATE_HEX(): Str = "#444B52"
fun COL_SKIP(): Str = "#C8A24B"

fun btnX(i: Nat): Rat = (NAV_W() * toRat(i))
fun btnKind(i: Nat): Str = if (i == 0) "ops" else (if (i == 1) "policy" else (if (i == 2) "attrs" else "blocks"))
@impure
fun btnLabel(m: Json, i: Nat): Str =
    if (i == 0) uiOps(modEnt(m))
    else (if (i == 1) uiPolicy(modEnt(m)) else (if (i == 2) uiAttrs(modEnt(m)) else uiBlocks(modEnt(m))))
fun btnHit(mx: Rat, my: Rat, i: Nat): Bool =
    if ((mx >= btnX(i)) && (mx <= (btnX(i) + BTN_W()))) ((my >= NAV_Y()) && (my <= (NAV_Y() + NAV_H()))) else false
@impure
fun whichBtnLoop(mx: Rat, my: Rat, i: Nat, n: Nat): Nat =
    if (i >= n) n else (if (btnHit(mx, my, i)) i else whichBtnLoop(mx, my, (i + 1), n))
@impure
fun whichBtn(mx: Rat, my: Rat): Nat = whichBtnLoop(mx, my, 0, BTN_N())

// ---------- MD3 Navigation Bar：底栏 + 4 项（过程化图标 + 文字 + 选中态高亮） ----------
@impure
fun buildBottombar(m: Json): Null { buildNav(m, "none"); null }
@impure
fun buildNav(m: Json, panel: Str): Null {
    objsDestroyTag("ui-nav")
    var bar: Any = addRectT(FS_W(), NAV_H(), 0.0, NAV_Y(), NAV_HEX(), "ui-nav", 35.0)
    buildNavItems(m, panel, 0, BTN_N())
    null
}
@impure
fun buildNavItems(m: Json, panel: Str, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var cx: Rat = (btnX(i) + (BTN_W() / 2.0))
        var sel: Bool = (strCmp(btnKind(i), panel) == 0)
        var col: Str = if (sel) PRIMARY_HEX() else TXT_VAR()
        var lc: Str = if (sel) TXT_HEX() else TXT_VAR()
        if (sel) {
            var ind: Any = addRoundRect(96.0, 40.0, (cx - 48.0), 1012.0, ROW_SEL(), "ui-nav", 13.0, 16.0)
        } else null
        drawNavIcon(i, cx, col)
        var bt: Any = addTextT(btnLabel(m, i), (cx - 60.0), 1058.0, 18.0, 400, lc, "ui-nav", true, 14.0)
        buildNavItems(m, panel, (i + 1), n)
    }
// 四类过程化图标（rect 拼接；选中态=Primary 色 + 指示器）
@impure
fun drawNavIcon(i: Nat, cx: Rat, col: Str): Null {
    if (i == 0) {
        var a1: Any = addRectT(14.0, 14.0, (cx - 21.0), 1018.0, col, "ui-nav", 36.0)
        var a2: Any = addRectT(14.0, 14.0, (cx + 7.0), 1018.0, col, "ui-nav", 36.0)
        var a3: Any = addRectT(14.0, 14.0, (cx - 21.0), 1036.0, col, "ui-nav", 36.0)
        var a4: Any = addRectT(14.0, 14.0, (cx + 7.0), 1036.0, col, "ui-nav", 36.0)
    } else { if (i == 1) {
        var b1: Any = addRectT(8.0, 12.0, (cx - 15.0), 1042.0, col, "ui-nav", 36.0)
        var b2: Any = addRectT(8.0, 26.0, (cx - 5.0), 1028.0, col, "ui-nav", 36.0)
        var b3: Any = addRectT(8.0, 40.0, (cx + 5.0), 1014.0, col, "ui-nav", 36.0)
    } else { if (i == 2) {
        var c1: Any = addRectT(30.0, 7.0, (cx - 15.0), 1018.0, col, "ui-nav", 36.0)
        var c2: Any = addRectT(30.0, 7.0, (cx - 15.0), 1032.0, col, "ui-nav", 36.0)
        var c3: Any = addRectT(30.0, 7.0, (cx - 15.0), 1046.0, col, "ui-nav", 36.0)
    } else {
        var d1: Any = addRectT(22.0, 22.0, (cx - 16.0), 1016.0, col, "ui-nav", 36.0)
        var d2: Any = addRectT(22.0, 22.0, (cx - 4.0), 1032.0, col, "ui-nav", 36.0)
    } } }
    null
}

// ---------- 全屏界面框架（MD3：底栏之上整屏 + 左上返回按钮） ----------
@impure
fun fsFrame(kind: Str): Null {
    var bg: Any = addRectT(FS_W(), 1080.0, 0.0, 0.0, FS_HEX(), "panel", 30.0)
    var bb2: Any = addRoundRect(BACK_W(), BACK_H(), BACK_X(), BACK_Y(), ROW_SEL(), "panel", 32.0, 20.0)
    var bt: Any = addTextT("‹ 返回地图", 84.0, 50.0, 22.0, 400, TXT_HEX(), "panel", true, 33.0)
    var tt: Any = addTextT(kind, TITLE_X(), TITLE_Y(), 34.0, 700, TXT_HEX(), "panel", true, 33.0)
    null
}
@impure
fun panelBackHit(mx: Rat, my: Rat): Bool =
    if ((mx >= BACK_X()) && (mx <= (BACK_X() + BACK_W()))) ((my >= BACK_Y()) && (my <= (BACK_Y() + BACK_H()))) else false
@impure
fun panelRowHitLoop(y: Rat, dy: Rat, my: Rat, i: Nat, n: Nat): Nat =
    if (i >= n) n
    else (if ((my >= y) && (my < (y + dy))) i else panelRowHitLoop((y + dy), dy, my, (i + 1), n))
@impure
fun panelRowHit(my: Rat, n: Nat, off: Nat): Nat = (off + panelRowHitLoop(ROW_Y0(), ROW_DY(), my, 0, n))
fun rowInRowX(mx: Rat): Bool = if ((mx >= ROW_X()) && (mx <= (ROW_X() + ROW_W()))) true else false

// ---------- 国策 / 属性 / 地块 全屏界面（MD3 列表） ----------
@impure
fun renderPanelKind(m: Json, s: Str, kind: Str): Str = renderPanelBody(m, engSetNum(s, F_SCROLL(), 0), kind)

// 面板内滚轮：保留滚动量局部刷新（不重置）
@impure
fun renderPanelRefresh(m: Json, s: Str, kind: Str): Str = renderPanelBody(m, s, kind)

@impure
fun renderPanelBody(m: Json, s: Str, kind: Str): Str {
    var ent: Json = modEnt(m)
    var off: Nat = engNum(s, F_SCROLL())
    objsDestroyTag("panel")
    fsFrame(if (strCmp(kind, "policy") == 0) uiPolicy(ent) else (if (strCmp(kind, "attrs") == 0) uiAttrs(ent) else uiBlocks(ent)))
    var n: Nat = if (strCmp(kind, "policy") == 0) policyCount(ent) else (if (strCmp(kind, "attrs") == 0) resCount(ent) else arrLen(jk(ent, "blocks")))
    if (strCmp(kind, "policy") == 0) renderPolicyRows(m, s, off, n, off)
    else { if (strCmp(kind, "attrs") == 0) renderAttrRows(m, s, off, n, off) else renderBlocksRows(m, off, n, off) }
    return engSet(s, F_PANEL(), kind)
}

@impure
fun fsRow(i: Nat, off: Nat, sel: Bool): Any = addRoundRect(ROW_W(), ROW_H(), ROW_X(), rowYOf(i, off), if (sel) ROW_SEL() else ROW_HEX(), "panel", 31.0, 20.0)
@impure
fun renderAttrRows(m: Json, s: Str, i: Nat, n: Nat, off: Nat): Null =
    if ((i >= n) || ((rowYOf(i, off) + ROW_H()) > NAV_Y())) null
    else {
        var v: Nat = resStrGet(engField(s, F_RES()), i)
        var p: Nat = resProduce(modEnt(m), i)
        var row: Any = fsRow(i, off, false)
        var nm: Any = addTextT(concat(resName(modEnt(m), i), toStr(v)), (ROW_X() + 32.0), (rowYOf(i, off) + 14.0), 28.0, 600, TXT_HEX(), "panel", true, 32.0)
        var sub: Any = addTextT(concat("产出 ", concat(toStr(p), "/天")), (ROW_X() + 32.0), (rowYOf(i, off) + 54.0), 20.0, 400, TXT_VAR(), "panel", true, 32.0)
        renderAttrRows(m, s, (i + 1), n, off)
    }
// 国策图标（TFR 素材）：方舱医院=疫苗研发、健康码体系=数字化、复工指导=地方复苏、
// 扩大核酸检测=大规模检测、紧缩节流=暂停消费经济；宽高各异用 fit 统一适配图标区
fun policyIconName(i: Nat): Str = if (i == 0) "ic-fangcang" else (if (i == 1) "ic-healthcode" else (if (i == 2) "ic-rework" else (if (i == 3) "ic-detection" else (if (i == 4) "ic-austerity" else ""))))
fun policyIconW(i: Nat): Rat = if (i == 0) 164.0 else (if (i == 1) 162.0 else (if (i == 2) 185.0 else (if (i == 3) 140.0 else 194.0)))
fun policyIconH(i: Nat): Rat = if (i == 0) 140.0 else (if (i == 1) 150.0 else (if (i == 2) 120.0 else (if (i == 3) 140.0 else 150.0)))
fun policyIconFit(i: Nat): Rat = if ((120.0 / policyIconW(i)) < (120.0 / policyIconH(i))) (120.0 / policyIconW(i)) else (120.0 / policyIconH(i))
// ---------- 国策树布局（HOI4 式：前置深度分层，同列按序竖排） ----------
fun TREE_X0(): Rat = 96.0
fun TREE_Y0(): Rat = 196.0
fun NT_W(): Rat = 260.0
fun NT_H(): Rat = 208.0
fun NT_CX(): Rat = 420.0
fun NT_CY(): Rat = 240.0
fun EDGE_HEX(): Str = "#5A6470"
// 国策两态：完成=亮板子，未完成=暗板子（文字说明前置/互斥原因）
fun PLAQ_ON(): Str = "#7FA8D9"
fun PLAQ_OFF(): Str = "#23282D"
fun PLAQ_TXT_ON(): Str = "#10233B"
// 列（深度）：无前置=0；否则 max(父列)+1。父缺失以哨兵 n 计 0 层
@impure
fun policyColOf(ent: Json, i: Nat): Nat =
    policyDepthMax(ent, policyPrereqList(ent, i), 0, arrLen(policyPrereqList(ent, i)), 0)
@impure
fun policyDepthMax(ent: Json, req: Json, k: Nat, n: Nat, acc: Nat): Nat =
    if (k >= n) acc
    else {
        var pid: Nat = policyIdIndex(ent, strOr(jsonStr(arrAt(req, k)), ""), 0, policyCount(ent))
        var d: Nat = if (pid >= policyCount(ent)) 0 else (policyColOf(ent, pid) + 1)
        policyDepthMax(ent, req, (k + 1), n, if (d > acc) d else acc)
    }
@impure
fun policyIdIndex(ent: Json, id: Str, i: Nat, n: Nat): Nat =
    if (i >= n) n
    else (if (strCmp(jstr(policyRow(ent, i), "id"), id) == 0) i else policyIdIndex(ent, id, (i + 1), n))
// 行：同列且在 i 之前的数量
@impure
fun policyRowOf(ent: Json, i: Nat): Nat =
    policyRowCount(ent, policyColOf(ent, i), 0, i, 0)
@impure
fun policyRowCount(ent: Json, col: Nat, j: Nat, lim: Nat, acc: Nat): Nat =
    if (j >= lim) acc
    else policyRowCount(ent, col, (j + 1), lim, if (policyColOf(ent, j) == col) (acc + 1) else acc)
@impure
fun policyBoxX(ent: Json, i: Nat): Rat = (TREE_X0() + (NT_CX() * toRat(policyColOf(ent, i))))
@impure
fun policyBoxY(ent: Json, i: Nat, off: Nat): Rat = (TREE_Y0() + (NT_CY() * toRat(policyRowOf(ent, i))) - (ROW_DY() * toRat(off)))
// ---------- 连线（父右中 -> 子左中，三段直角折线） ----------
@impure
fun drawTreeEdgesLoop(ent: Json, i: Nat, req: Json, k: Nat, n: Nat, off: Nat): Null =
    if (k >= n) null
    else {
        var pid: Nat = policyIdIndex(ent, strOr(jsonStr(arrAt(req, k)), ""), 0, policyCount(ent))
        if (pid < policyCount(ent)) { drawTreeEdge(ent, pid, i, off) } else null
        drawTreeEdgesLoop(ent, i, req, (k + 1), n, off)
    }
@impure
fun drawTreeEdge(ent: Json, p: Nat, c: Nat, off: Nat): Null {
    var px: Rat = (policyBoxX(ent, p) + NT_W())
    var py: Rat = (policyBoxY(ent, p, off) + (NT_H() / 2.0))
    var cx: Rat = policyBoxX(ent, c)
    var cy: Rat = (policyBoxY(ent, c, off) + (NT_H() / 2.0))
    var mx: Rat = ((px + cx) / 2.0)
    var h1: Any = addRectT((mx - px), 3.0, px, (py - 1.5), EDGE_HEX(), "panel", 30.0)
    var v: Any = if (cy > py) addRectT(3.0, (cy - py), (mx - 1.5), py, EDGE_HEX(), "panel", 30.0) else addRectT(3.0, (py - cy), (mx - 1.5), cy, EDGE_HEX(), "panel", 30.0)
    var h2: Any = addRectT((cx - mx), 3.0, mx, (cy - 1.5), EDGE_HEX(), "panel", 30.0)
    null
}
// ---------- 锁定原因文本 ----------
@impure
fun policyNamesOf(ent: Json, req: Json, i: Nat, n: Nat, sep: Str): Str =
    if (i >= n) ""
    else {
        var nm: Str = lookupName(policies(ent), strOr(jsonStr(arrAt(req, i)), ""))
        var part: Str = if (strCmp(nm, "") == 0) "" else nm
        var rest: Str = policyNamesOf(ent, req, (i + 1), n, sep)
        if (strCmp(part, "") == 0) rest else (if (strCmp(rest, "") == 0) part else concat(concat(part, sep), rest))
    }
@impure
fun policyLockText(ent: Json, s: Str, i: Nat): Str =
    if (policyAcquired(ent, s, i)) ""
    else (if (policyCanAcquire(ent, s, i)) "" else policyBlockText(ent, s, i))
@impure
fun policyBlockText(ent: Json, s: Str, i: Nat): Str =
    if (policyMutexLocked(ent, s, i)) concat("与【", concat(policyNamesOf(ent, policyMutexList(ent, i), 0, arrLen(policyMutexList(ent, i)), "/"), "】互斥"))
    else {
        var rq: Json = policyPrereqList(ent, i)
        if (arrLen(rq) == 0) ""
        else (if (strCmp(policyPrereqMode(ent, i), "any") == 0) concat("需任一：", policyNamesOf(ent, rq, 0, arrLen(rq), " 或 ")) else concat("前置：", policyNamesOf(ent, rq, 0, arrLen(rq), "、")))
    }
// ---------- 树渲染 ----------
@impure
fun renderPolicyRows(m: Json, s: Str, i: Nat, n: Nat, off: Nat): Null =
    if (i >= n) null
    else {
        var ent: Json = modEnt(m)
        var acq: Bool = policyAcquired(ent, s, i)
        var x: Rat = policyBoxX(ent, i)
        var y: Rat = policyBoxY(ent, i, off)
        if ((y + NT_H()) > NAV_Y()) null
        else {
            drawTreeEdgesLoop(ent, i, policyPrereqList(ent, i), 0, arrLen(policyPrereqList(ent, i)), off)
            // 图标（HOI4 式：大图标在上；完成原色，未完成暗化）
            var icn: Str = policyIconName(i)
            var fit: Rat = policyIconFit(i)
            var iw: Rat = (policyIconW(i) * fit)
            var ih: Rat = (policyIconH(i) * fit)
            if (strCmp(icn, "") != 0) { addIconT(icn, (x + ((NT_W() - iw) / 2.0)), (y + 8.0 + ((120.0 - ih) / 2.0)), fit, "panel", 33.0, if (acq) "#FFFFFF" else "#7D8590") } else null
            // 板子（国策名 + 原因小字；完成=亮，未完成=暗）
            var box: Any = addRoundRect((NT_W() - 16.0), 60.0, (x + 8.0), (y + 136.0), if (acq) PLAQ_ON() else PLAQ_OFF(), "panel", 32.0, 10.0)
            var nm: Str = jstr(policyRow(ent, i), "name")
            var tw: Rat = (22.0 * toRat(length(nm)))
            var mt: Any = addTextT(nm, (x + 8.0 + ((244.0 - tw) / 2.0)), (y + 146.0), 22.0, 600, if (acq) PLAQ_TXT_ON() else TXT_VAR(), "panel", true, 33.0)
            var rst: Str = policyLockText(ent, s, i)
            var rw: Rat = (14.0 * toRat(length(rst)))
            var st: Any = addTextT(rst, (x + 8.0 + ((244.0 - rw) / 2.0)), (y + 180.0), 14.0, 400, TXT_VAR(), "panel", true, 33.0)
            renderPolicyRows(m, s, (i + 1), n, off)
        }
    }
@impure
fun policyReqText(ent: Json, i: Nat): Str =
    if (arrLen(jk(policyRow(ent, i), "requires")) == 0) ""
    else concat("  前置：", reqNamesLoop(ent, jk(policyRow(ent, i), "requires"), 0, arrLen(jk(policyRow(ent, i), "requires")), ""))
@impure
fun reqNamesLoop(ent: Json, req: Json, i: Nat, n: Nat, acc: Str): Str =
    if (i >= n) acc
    else {
        var nm: Str = lookupName(policies(ent), strOr(jsonStr(arrAt(req, i)), ""))
        reqNamesLoop(ent, req, (i + 1), n, if (i == 0) nm else concat(concat(acc, "、"), nm))
    }
@impure
fun renderBlocksRows(m: Json, i: Nat, n: Nat, off: Nat): Null =
    if ((i >= n) || ((rowYOf(i, off) + ROW_H()) > NAV_Y())) null
    else {
        var ent: Json = modEnt(m)
        var nm: Str = jstr(arrAt(jk(ent, "blocks"), i), "name")
        var ow: Str = countryName(ent, jstr(arrAt(jk(ent, "blocks"), i), "owner"))
        var row: Any = fsRow(i, off, false)
        var rt: Any = addTextT(nm, (ROW_X() + 32.0), (rowYOf(i, off) + 14.0), 28.0, 600, TXT_HEX(), "panel", true, 32.0)
        var st: Any = addTextT(concat("归属 ", ow), (ROW_X() + 32.0), (rowYOf(i, off) + 54.0), 20.0, 400, TXT_VAR(), "panel", true, 32.0)
        renderBlocksRows(m, (i + 1), n, off)
    }
@impure
fun policyPanelHit(m: Json, s: Str, mx: Rat, my: Rat): Str {
    var ent: Json = modEnt(m)
    var n: Nat = policyCount(ent)
    var off: Nat = engNum(s, F_SCROLL())
    var ri: Nat = policyTreeHit(ent, mx, my, off, 0, n)
    return (if (ri < n) engPolicyAcquire(m, s, ri) else s)
}
@impure
fun policyTreeHit(ent: Json, mx: Rat, my: Rat, off: Nat, i: Nat, n: Nat): Nat =
    if (i >= n) n
    else {
        var x: Rat = policyBoxX(ent, i)
        var y: Rat = policyBoxY(ent, i, off)
        if ((mx >= x) && (mx < (x + NT_W())) && (my >= y) && (my < (y + NT_H()))) i else policyTreeHit(ent, mx, my, off, (i + 1), n)
    }

// ---------- 操作：页列表（MD3 列表 + 结束操作行） ----------
@impure
fun renderOpsMain(m: Json, s: Str): Null {
    var ent: Json = modEnt(m)
    var ci: Nat = engNum(s, F_CHAP())
    var ops: Json = chapterOps(ent, ci)
    fsFrame(opsMainTitle(ent, ci, s))
    renderOpsMainRows(m, s, 0, arrLen(ops))
    var rows: Nat = arrLen(ops)
    var row: Any = fsRow(rows, 0, false)
    var skip: Any = addTextT("结束操作（不操作，直接结算）", (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(rows)) + 26.0), 24.0, 400, COL_SKIP(), "panel", true, 32.0)
    null
}
@impure
fun opsMainTitle(ent: Json, ci: Nat, s: Str): Str =
    concat(concat(concat(chapterAct(ent, ci), " · "), chapterName(ent, ci)), opsApText(s))
@impure
fun opsApText(s: Str): Str = concat(concat("  行动点 ", toStr(engNum(s, F_AP()))), concat(" / ", toStr(engNum(s, F_APMAX()))))
@impure
fun renderOpsMainRows(m: Json, s: Str, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var ent: Json = modEnt(m)
        var pg: Json = arrAt(chapterOps(ent, engNum(s, F_CHAP())), i)
        var row: Any = fsRow(i, 0, false)
        var nm: Any = addTextT(jstr(pg, "name"), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 14.0), 28.0, 600, TXT_HEX(), "panel", true, 32.0)
        var ds: Any = addTextT(jstr(pg, "desc"), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 54.0), 20.0, 400, TXT_VAR(), "panel", true, 32.0)
        renderOpsMainRows(m, s, (i + 1), n)
    }

// ---------- 操作页：状态条 + radio 组选项（MD3 Button：选中=Primary filled） ----------
@impure
fun renderOpsPage(m: Json, s: Str, pid: Nat): Null {
    var ent: Json = modEnt(m)
    var ci: Nat = engNum(s, F_CHAP())
    var pg: Json = arrAt(chapterOps(ent, ci), pid)
    fsFrame(jstr(pg, "name"))
    var st1: Any = addTextT(opsStripText(m, s, pg), (ROW_X() + 4.0), STRIP_Y(), 24.0, 400, TXT_VAR(), "panel", true, 32.0)
    renderOpsPageRows(m, s, pid, pg, 0, arrLen(jk(pg, "options")))
    var rows: Nat = arrLen(jk(pg, "options"))
    var row: Any = fsRow(rows, 0, false)
    var back: Any = addTextT("返回操作页", (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(rows)) + 26.0), 24.0, 400, TXT_VAR(), "panel", true, 32.0)
    null
}
@impure
fun opsStripText(m: Json, s: Str, pg: Json): Str {
    var ap: Str = concat(concat(concat("行动点 ", toStr(engNum(s, F_AP()))), " / "), toStr(engNum(s, F_APMAX())))
    return concat(ap, opsStatusLoop(m, s, jk(pg, "status"), 0, arrLen(jk(pg, "status")), ""))
}
@impure
fun opsStatusLoop(m: Json, s: Str, st: Json, i: Nat, n: Nat, acc: Str): Str =
    if (i >= n) acc
    else {
        var ent: Json = modEnt(m)
        var rid: Str = strOr(jsonStr(arrAt(st, i)), "")
        var part: Str = concat(concat(concat(" · ", lookupName(jk(ent, "resources"), rid)), " "), toStr(resValById(ent, s, rid)))
        opsStatusLoop(m, s, st, (i + 1), n, concat(acc, part))
    }
@impure
fun renderOpsPageRows(m: Json, s: Str, pid: Nat, pg: Json, i: Nat, n: Nat): Null =
    if (i >= n) null
    else {
        var opts: Json = jk(pg, "options")
        var sel: Bool = strHas(engField(s, F_SEL()), selToken(pid, i))
        var dot: Str = if (sel) "● " else "○ "
        var row: Any = fsRow(i, 0, sel)
        var nm: Any = addTextT(concat(dot, jstr(arrAt(opts, i), "name")), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 14.0), 28.0, 600, if (sel) ON_PRIMARY() else TXT_HEX(), "panel", true, 32.0)
        var ds: Any = addTextT(jstr(arrAt(opts, i), "desc"), (ROW_X() + 32.0), (ROW_Y0() + (ROW_DY() * toRat(i)) + 54.0), 20.0, 400, if (sel) ON_PRIMARY() else TXT_VAR(), "panel", true, 32.0)
        renderOpsPageRows(m, s, pid, pg, (i + 1), n)
    }

// ---------- 操作界面点击分派（全屏行带） ----------
@impure
fun opsPanelHit(m: Json, s: Str, mx: Rat, my: Rat): Str {
    var ent: Json = modEnt(m)
    var ops: Json = chapterOps(ent, engNum(s, F_CHAP()))
    if (!rowInRowX(mx)) { return s } else null
    if (strCmp(engField(s, F_PAGE()), "L") == 0) {
        var rows: Nat = arrLen(ops)
    var ri: Nat = panelRowHit(my, (rows + 1), 0)
        return (if (ri < rows) engOpenOpsPage(m, s, ri) else (if (ri == rows) engOpsSkip(m, s) else s))
    } else {
        var pid: Nat = natOr(parseNat(engField(s, F_PAGE())), 0)
        var opts: Json = jk(arrAt(ops, pid), "options")
        var rows2: Nat = arrLen(opts)
    var ri2: Nat = panelRowHit(my, (rows2 + 1), 0)
        return (if (ri2 < rows2) engOpsExec(m, s, pid, ri2) else (if (ri2 == rows2) engOpsBack(m, s) else s))
    }
}