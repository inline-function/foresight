// main.subl —— 主场景（t89：1920x1080 2x 分辨率 + MD3 风格壳）
// 世界坐标整体 x2；游戏逻辑（引擎 st2、六段 tick 循环）不变。
// 地图地块几何 x2 在 mapTableOf 里做（smoke-data 几何字符串标量放大），不改数据文件。
fun VIEW_W(): Rat = 1920.0
fun VIEW_H(): Rat = 1080.0
fun LABEL_Y(): Rat = 972.0

// 地图世界范围（x2）
fun TX0(): Rat = (E_TX0() * 2.0)
fun TX1(): Rat = (E_TX1() * 2.0)
fun TY0(): Rat = (E_TY0() * 2.0)
fun TY1(): Rat = (E_TY1() * 2.0)
fun INIT_X(): Rat = (E_INIT_X() * 2.0)
fun INIT_Y(): Rat = (E_INIT_Y() * 2.0)

// MD3 深色 tonal 色板（Surface/Primary/OnSurface/Outline 各级）
fun COL_BG(): Str = "#0F1113"
fun COL_SEA(): Str = "#101820"
fun COL_TITLE(): Str = "#E4E7EA"
fun COL_SUB(): Str = "#B7BFC8"
fun COL_PRIMARY(): Str = "#A6C8FF"
fun FILL_SEL(): Str = "#A6C8FF"

fun CTR_X(): Rat = 960.0
fun CTR_Y(): Rat = 540.0
fun ZOOM_MIN(): Rat = 1.0
fun ZOOM_MAX(): Rat = 8.0
fun ZOOM_STEP(): Rat = 1.15
fun PAD(): Rat = 16.0
fun DRAG_THRESHOLD(): Rat = 16.0
fun blockHex(i: Nat): Str =
    if ((i % 2) == 0) "#31506B" else "#3A4656"
// 省下标 -> 国家色（表按国家分段；E_* 段界来自 east-data.subl）
fun provHex(i: Nat): Str =
    if (i < E1()) C_CHN()
    else (if (i < E2()) C_JPN()
    else (if (i < E3()) C_KOR()
    else (if (i < E4()) C_PRK()
    else (if (i < E5()) C_MNG()
    else (if (i < E6()) C_VNM()
    else (if (i < E7()) C_LAO()
    else (if (i < E8()) C_KHM()
    else (if (i < E9()) C_THA()
    else (if (i < E10()) C_MMR()
    else (if (i < E11()) C_MYS()
    else C_SGP()))))))))))
// 背景板分段色：俄/印/哈/吉/塔/阿/巴（整国抽稀，不参与命中）
fun bgHex(i: Nat): Str =
    if (i < E_RUS()) C_RUS()
    else (if (i < E_IND()) C_IND()
    else (if (i < E_KAZ()) C_KAZ()
    else (if (i < E_KGZ()) C_KGZ()
    else (if (i < E_TJK()) C_TJK()
    else (if (i < E_AFG()) C_AFG()
    else C_PAK())))))
// 表整体 x2：把 name:geom|... 的几何部分放大（名称保留）
@impure
fun tblX2Loop(rows: List[Str], i: Nat, acc: Str): Str =
    if (!listHas(rows, i)) acc
    else {
        var row: Str = strOr(elementAt(rows, i), "")
        var parts: List[Str] = strSplit(row, ":")
        var nm: Str = strOr(elementAt(parts, 0), "")
        var geo: Str = strOr(elementAt(parts, 1), "")
        var made: Str = concat(concat(nm, ":"), geomScale(geo))
        tblX2Loop(rows, (i + 1), if (strCmp(acc, "") == 0) made else concat(concat(acc, "|"), made))
    }
@impure
fun tblX2(tbl: Str): Str = tblX2Loop(strSplit(tbl, "|"), 0, "")

fun visW(viewS: Rat): Rat = (VIEW_W() / viewS)
fun visH(viewS: Rat): Rat = (VIEW_H() / viewS)
fun panMinX(viewS: Rat): Rat = ((TX0() - PAD()) + (visW(viewS) / 2.0))
fun panMaxX(viewS: Rat): Rat = ((TX1() + PAD()) - (visW(viewS) / 2.0))
fun panMinY(viewS: Rat): Rat = ((TY0() - PAD()) + (visH(viewS) / 2.0))
fun panMaxY(viewS: Rat): Rat = ((TY1() + PAD()) - (visH(viewS) / 2.0))
fun clampS(v: Rat, lo: Rat, hi: Rat): Rat = if (v < lo) lo else (if (v > hi) hi else v)
fun clampP(v: Rat, lo: Rat, hi: Rat): Rat = if (lo > hi) ((lo + hi) / 2.0) else (if (v < lo) lo else (if (v > hi) hi else v))
fun distAbs(a: Rat, b: Rat): Rat = if (a > b) (a - b) else (b - a)
fun rectCap(w: Rat, h: Rat, r: Rat): Rat = if (w < h) (if (r > (w / 2.0)) (w / 2.0) else r) else (if (r > (h / 2.0)) (h / 2.0) else r)
fun screenXOf(viewS: Rat, viewX: Rat, w: Rat): Rat = (((w - viewX) * viewS) + CTR_X())
fun screenYOf(viewS: Rat, viewY: Rat, w: Rat): Rat = (((w - viewY) * viewS) + CTR_Y())
fun worldXOf(viewS: Rat, viewX: Rat, s: Rat): Rat = (((s - CTR_X()) / viewS) + viewX)
fun worldYOf(viewS: Rat, viewY: Rat, s: Rat): Rat = (((s - CTR_Y()) / viewS) + viewY)
fun zoomViewXAt(viewS: Rat, viewX: Rat, wa: Rat, ns: Rat): Rat = (wa - ((screenXOf(viewS, viewX, wa) - CTR_X()) / ns))
fun zoomViewYAt(viewS: Rat, viewY: Rat, wa: Rat, ns: Rat): Rat = (wa - ((screenYOf(viewS, viewY, wa) - CTR_Y()) / ns))
fun panXOf(viewS: Rat, viewX: Rat, dx: Rat): Rat = clampP((viewX - (dx / viewS)), panMinX(viewS), panMaxX(viewS))
fun panYOf(viewS: Rat, viewY: Rat, dy: Rat): Rat = clampP((viewY - (dy / viewS)), panMinY(viewS), panMaxY(viewS))

// ---------- 通用 UI 组件（fixed 屏幕坐标 + z 分层；顶栏 10-12 / 底栏 10-14 / 全屏界面 30 / 事件层 26-100） ----------
@impure
fun addRectT(w: Rat, h: Rat, x: Rat, y: Rat, hex: Str, tag: Str, z: Rat): Any {
    unchecked var o = objAdd()
    unchecked objUse(o, compPos(x, y))
    unchecked objUse(o, compRect(w, h))
    unchecked objUse(o, compColorHex(hex))
    unchecked objUse(o, compFixed())
    unchecked objUse(o, compZ(z))
    unchecked objTag(o, tag)
    return o
}
// MD3 圆角：rect + 四角 circle 同色拼接（compCircle 为实心圆；r<=0 退化为直角）
@impure
@impure
fun addRoundRect(w: Rat, h: Rat, x: Rat, y: Rat, hex: Str, tag: Str, z: Rat, r: Rat): Any {
    var rr: Rat = rectCap(w, h, r)
    unchecked var o = objAdd()
    unchecked objUse(o, compPos(x, y))
    unchecked objUse(o, compRectR(w, h, rr))
    unchecked objUse(o, compColorHex(hex))
    unchecked objUse(o, compFixed())
    unchecked objUse(o, compZ(z))
    unchecked objTag(o, tag)
    return o
}
@impure
fun addCircleT(r: Rat, x: Rat, y: Rat, hex: Str, tag: Str, z: Rat): Null {
    unchecked var o = objAdd()
    unchecked objUse(o, compPos(x, y))
    unchecked objUse(o, compCircle(r))
    unchecked objUse(o, compColorHex(hex))
    unchecked objUse(o, compFixed())
    unchecked objUse(o, compZ(z))
    unchecked objTag(o, tag)
    null
}
@impure
fun addTextT(t: Str, x: Rat, y: Rat, size: Rat, w: Nat, hex: Str, tag: Str, fixed: Bool, z: Rat): Any {
    unchecked var o = objAdd()
    unchecked objUse(o, compPos(x, y))
    unchecked objUse(o, compText(t, size, w))
    unchecked objUse(o, compColorHex(hex))
    unchecked if (fixed) { objUse(o, compFixed()); objUse(o, compZ(z)) }
    unchecked objTag(o, tag)
    return o
}
// 精灵图标（fixed + z；sc 按图标原始像素折算）
@impure
fun addIconT(name: Str, x: Rat, y: Rat, sc: Rat, tag: Str, z: Rat, hex: Str): Null {
    unchecked var o = objAdd()
    unchecked objUse(o, compPos(x, y))
    unchecked objUse(o, compSprite(name))
    unchecked objUse(o, compScale(sc))
    unchecked objUse(o, compColorHex(hex))
    unchecked objUse(o, compFixed())
    unchecked objUse(o, compZ(z))
    unchecked objTag(o, tag)
    null
}
// 折行文本（width>0 触发 KAPLAY 原生折行；CJK 图集分桶 + 线性过滤保证锐利）
@impure
fun addTextWrap(t: Str, x: Rat, y: Rat, size: Rat, w: Nat, width: Rat, hex: Str, tag: Str, fixed: Bool, z: Rat): Any {
    unchecked var o = objAdd()
    unchecked objUse(o, compPos(x, y))
    unchecked objUse(o, compText(t, size, w, width, 8.0))
    unchecked objUse(o, compColorHex(hex))
    unchecked if (fixed) { objUse(o, compFixed()); objUse(o, compZ(z)) }
    unchecked objTag(o, tag)
    return o
}
@impure
fun addTextC(t: Str, cx: Rat, cy: Rat, size: Rat, hex: Str, tag: Str, fixed: Bool, z: Rat): Any {
    unchecked var o = objAdd()
    unchecked objUse(o, compPos(cx, cy))
    unchecked objUse(o, compText(t, size, 400, 0))
    unchecked objUse(o, compColorHex(hex))
    unchecked objUse(o, compAnchor("center"))
    unchecked if (fixed) { objUse(o, compFixed()); objUse(o, compZ(z)) }
    unchecked objTag(o, tag)
    return o
}

// ---------- 地图：地块命名/归属来自模组 entities.blocks，几何 x2 标量放大 ----------
@impure
fun blockCount(ent: Json): Nat = arrLen(jk(ent, "blocks"))
@impure
fun mapRowsLoop(ent: Json, n: Nat, i: Nat, acc: Str): Str =
    if (i >= n) acc
    else {
        var nm: Str = jstr(arrAt(jk(ent, "blocks"), i), "name")
        var row: Str = concat(concat(nm, ":"), geomScale(geomOf(i)))
        var sep: Str = if (i == 0) "" else "|"
        mapRowsLoop(ent, n, (i + 1), concat(concat(acc, sep), row))
    }
@impure
fun mapTableOf(ent: Json): Str = mapRowsLoop(ent, blockCount(ent), 0, "")
// 几何表整体 x2：「x y,x y;...」按 ';' 分环、',' 分点、' ' 分点内坐标（List 逐项 Optional 扫描）
@impure
fun geomScale(t: Str): Str = geomRingScan(strSplit(t, ";"), 0, "")
@impure
fun geomRingScan(rings: List[Str], i: Nat, acc: Str): Str =
    if (!listHas(rings, i)) acc
    else {
        var part: Str = geomPtScan(strSplit(strOr(elementAt(rings, i), ""), ","), 0, "")
        geomRingScan(rings, (i + 1), if (strCmp(acc, "") == 0) part else concat(concat(acc, ";"), part))
    }
@impure
fun geomPtScan(pts: List[Str], i: Nat, acc: Str): Str =
    if (!listHas(pts, i)) acc
    else {
        var parts: List[Str] = strSplit(strOr(elementAt(pts, i), ""), " ")
        var x: Rat = when (parseRat(strOr(elementAt(parts, 0), "0"))) { is Some(v) => v; None => 0.0 }
        var y: Rat = when (parseRat(strOr(elementAt(parts, 1), "0"))) { is Some(v) => v; None => 0.0 }
        var made: Str = concat(concat(toStr(x * 2.0), " "), toStr(y * 2.0))
        geomPtScan(pts, (i + 1), if (i == 0) made else concat(concat(acc, ","), made))
    }
fun listHas(lst: List[Str], i: Nat): Bool = when (elementAt(lst, i)) { is Some(_) => true; None => false }

// ---------- 渲染：地块（矢量精灵 + 点击高亮） ----------
@impure
fun renderBlocksLoop(geo: Any, n: Nat, i: Nat, sel: Int): Null =
    if (i >= n) null
    else {
        var hex: Str = if (i == sel) FILL_SEL() else provHex(i)
        var o: Any = mapProvObj(geo, i, hex)
        objTag(o, "block")
        renderBlocksLoop(geo, n, (i + 1), sel)
    }
@impure
fun renderBlocks(geo: Any, n: Nat, sel: Int): Null = renderBlocksLoop(geo, n, 0, sel)
@impure
fun renderBgLoop(geo: Any, n: Nat, i: Nat): Null =
    if (i >= n) null
    else {
        var o: Any = mapProvObj(geo, i, bgHex(i))
        objTag(o, "provbg")
        renderBgLoop(geo, n, (i + 1))
    }
@impure
fun renderBg(geo: Any, n: Nat): Null = renderBgLoop(geo, n, 0)
// ---------- 海域地块（渲染于陆地之下；C_OCEAN 深一层蓝） ----------
fun C_OCEAN(): Str = "#1B4A66"
@impure
fun renderSeaLoop(geo: Any, n: Nat, i: Nat): Null =
    if (i >= n) null
    else {
        var o: Any = mapProvObj(geo, i, C_OCEAN())
        objTag(o, "seaprov")
        renderSeaLoop(geo, n, (i + 1))
    }
@impure
fun renderSea(geo: Any, n: Nat): Null = renderSeaLoop(geo, n, 0)

@impure
fun applyView(viewS: Rat, viewX: Rat, viewY: Rat): Null {
    camPos(viewX, viewY)
    camScale(viewS, viewS)
    null
}

@impure
fun selectAt(geo: Any, n: Nat, label: Any, sel: Int, wx: Rat, wy: Rat): Int {
    var hit: Int = mapHitProv(geo, wx, wy)
    @mut var r: Int = sel
    if (hit >= 0) {
        if (hit != sel) {
            objsDestroyTag("block")
            r = hit
            renderBlocks(geo, n, hit)
            objTextSet(label, concat("已选：", mapProvName(geo, hit)))
        }
    }
    return r
}

// ---------- 主场景 ----------
@impure
fun runSmoke(): Null {
    var m: Json = activeMod()
    var md: Json = modMod(m)
    var ent: Json = modEnt(m)
    var geo: Any = mapLoad(tblX2(mapEastFg()))
    var n: Nat = mapProvCount(geo)
    var geoBg: Any = mapLoad(tblX2(mapEastBg()))
    var nBg: Nat = mapProvCount(geoBg)
    var geoSea: Any = mapLoad(tblX2(mapSea()))
    var nSea: Nat = mapProvCount(geoSea)
    var bg: Any = objAdd()
    unchecked objUse(bg, compPos((TX0() - PAD()), (TY0() - PAD())))
    unchecked objUse(bg, compRect(((TX1() - TX0()) + (PAD() * 2.0)), ((TY1() - TY0()) + (PAD() * 2.0))))
    unchecked objUse(bg, compColorHex(COL_SEA()))
    unchecked objTag(bg, "ui")
    @mut var sel: Int = -1
    @mut var drX: Rat = 0.0
    @mut var drClosing: Bool = false
    @mut var drPairs: List[(Any, Rat, Rat)] = emptyList()
    @mut var autoOn: Bool = false
    @mut var autoAcc: Rat = 0.0
    @mut var startSfx: Bool = false
    @mut var st: Str = engInit(md, ent)
    buildTopbar(m, st)
    var label: Any = addTextC("", 960.0, LABEL_Y(), 26.0, COL_SUB(), "ui", true, 22.0)
    buildBottombar(m)
    drawAutoBtn(autoOn)
    renderSea(geoSea, nSea)
    renderBg(geoBg, nBg)
    renderBlocks(geo, n, -1)
    @mut var viewS: Rat = 1.0
    @mut var viewX: Rat = INIT_X()
    @mut var viewY: Rat = INIT_Y()
    @mut var pressX: Rat = 0.0
    @mut var pressY: Rat = 0.0
    @mut var lastX: Rat = 0.0
    @mut var lastY: Rat = 0.0
    @mut var pressed: Bool = false
    @mut var moved: Bool = false
    renderBlocks(geo, n, -1)
    applyView(viewS, viewX, viewY)
    // 引擎起步：tick 1（相位1 日期推进+资源产出 -> 相位2 玩家操作；队长裁决：进游戏先看地图，
    // 操作/国策/属性/地块界面由底栏按钮切全屏打开）
    st = engTickStart(m, st)
    // 音频/图标资产预载（TFR 素材；缺失静默）：国策图标 + 主界面 BGM（TFR 主题曲 ogg 循环）
    var l0: Null = spriteLoad("ic-fangcang", "assets/img/ic-fangcang.png")
    var l1: Null = spriteLoad("ic-healthcode", "assets/img/ic-healthcode.png")
    var l2: Null = spriteLoad("ic-rework", "assets/img/ic-rework.png")
    var l3: Null = spriteLoad("ic-detection", "assets/img/ic-detection.png")
    var l4: Null = spriteLoad("ic-austerity", "assets/img/ic-austerity.png")
    var l5: Null = spriteLoad("ic-lockdown", "assets/img/ic-lockdown.png")
    var l6: Null = spriteLoad("ic-epi", "assets/img/ic-epi.png")
    var l7: Null = spriteLoad("ic-vaccine", "assets/img/ic-vaccine.png")
    var l8: Null = spriteLoad("ic-herd", "assets/img/ic-herd.png")
    var au0: Bool = bgmPlayId(BGM_MAIN())
    onScroll { dy =>
        var pn: Str = engField(st, F_PANEL())
        var ph: Str = engField(st, F_PHASE())
        if ((strCmp(ph, "events") == 0) && (strCmp(pn, "none") == 0) && (strCmp(qHead(engField(st, F_QUEUE())), "") != 0)) {
            var ev: Json = evById(modEnt(m), qHead(engField(st, F_QUEUE())))
            if (strCmp(jstr(ev, "kind"), "card") == 0) {
                var n: Nat = cardContentLines(jstr(ev, "content"))
                var maxOff: Nat = if (n > CC_TXT_FIT()) (n - CC_TXT_FIT()) else 0
                var cur: Nat = engNum(st, F_SCROLL())
                var nxt: Nat = if (dy > 0.0) (if (cur < maxOff) (cur + 1) else cur) else (if (cur > 0) (cur - 1) else 0)
                if (nxt != cur) { objsDestroyTag("view"); renderEventRefresh(m, engSetNum(st, F_SCROLL(), nxt)); st = engSetNum(st, F_SCROLL(), nxt) } else null
            } else null
        } else {

        if (strCmp(pn, "none") != 0) {
            var ent: Json = modEnt(m)
            var n: Nat = if (strCmp(pn, "policy") == 0) policyCount(ent) else (if (strCmp(pn, "attrs") == 0) resCount(ent) else arrLen(jk(ent, "blocks")))
            var maxOff: Nat = if (n > ROWS_FIT()) (n - ROWS_FIT()) else 0
            var cur: Nat = engNum(st, F_SCROLL())
            var nxt: Nat = if (dy > 0.0) (if (cur < maxOff) (cur + 1) else cur) else (if (cur > 0) (cur - 1) else cur)
            if (nxt != cur) { st = renderPanelRefresh(m, engSetNum(st, F_SCROLL(), nxt), pn) }
        } else {
        var f: Rat = if (dy > 0.0) (1.0 / ZOOM_STEP()) else ZOOM_STEP()
        var gx: Rat = worldXOf(viewS, viewX, mousePosX())
        var gy: Rat = worldYOf(viewS, viewY, mousePosY())
        var ns: Rat = clampS((viewS * f), ZOOM_MIN(), ZOOM_MAX())
        if (ns != viewS) {
            viewX = zoomViewXAt(viewS, viewX, gx, ns)
            viewY = zoomViewYAt(viewS, viewY, gy, ns)
            viewX = panXOf(ns, viewX, 0.0)
            viewY = panYOf(ns, viewY, 0.0)
            viewS = ns
            applyView(ns, viewX, viewY)
        }
        }
        }
    }
onUpdate { dt =>
    // 非事件阶段回到主界面 BGM（同名去重；首播被手势拦截则逐帧重试）
    var bm: Bool = if (strCmp(engField(st, F_PHASE()), "events") == 0) false else bgmPlayId(BGM_MAIN())
    if (drClosing) {
        var nx: Rat = (drX - (DR_SPEED() * dt))
        if (nx <= DR_OFF_X()) { drClosing = false; objsDestroyTag("drawer"); drPairs = emptyList(); drX = 0.0 } else { drX = nx; drShift(drPairs, nx) }
    } else { if (drX < 0.0) {
        var nx2: Rat = (drX + (DR_SPEED() * dt))
        drX = if (nx2 > 0.0) 0.0 else nx2
        drShift(drPairs, drX)
    } else null };
    if (autoOn) {
        autoAcc = autoAcc + dt
        if (autoAcc >= 1.0) {
            autoAcc = autoAcc - 1.0
            if (strCmp(engField(st, F_PHASE()), "idle") == 0) { st = engTickStart(m, st) } else null
        } else null
    } else { autoAcc = 0.0 } }
    onMouseDown("left") { _e => if (!pressed) {
        pressed = true
        moved = false
        pressX = mousePosX()
        pressY = mousePosY()
        lastX = pressX
        lastY = pressY
        // 首次手势解锁音频（浏览器自动播放策略）：开场音；之后底栏按钮按下 click
        var s0: Bool = if (startSfx) false else sfxPlay("start")
        var b0: Nat = whichBtn(pressX, pressY)
        if (b0 < BTN_N()) {
            // MD3 状态层：按下底栏按钮即闪覆盖色
            var s2: Bool = if (startSfx) sfxPlay("click") else false
            var fl: Any = addRectT(NAV_W(), NAV_H(), btnX(b0), NAV_Y(), "#444B52", "statelayer", 40.0)
        } else null
        if (startSfx) null else { startSfx = true }
    } }
    onMouseMove { _m => if (pressed) {
        var mx: Rat = mousePosX()
        var my: Rat = mousePosY()
        var dx: Rat = distAbs(mx, pressX)
        var dy2: Rat = distAbs(my, pressY)
        if ((!moved) && ((dx > DRAG_THRESHOLD()) || (dy2 > DRAG_THRESHOLD()))) { moved = true }
        if ((moved) && ((strCmp(engField(st, F_DRAWER()), "none") == 0) || (pressX >= DR_W()))) {
            viewX = panXOf(viewS, viewX, (mx - lastX))
            viewY = panYOf(viewS, viewY, (my - lastY))
            applyView(viewS, viewX, viewY)
        }
        lastX = mx
        lastY = my
    } }
    onMouseRelease("left") { _e => if (pressed) {
        objsDestroyTag("statelayer")
        @mut var consumed: Bool = false
        if (!moved) {
            var ph: Str = engField(st, F_PHASE())
            if (strCmp(ph, "over") == 0) null
            else {
                if ((strCmp(engField(st, F_DRAWER()), "none") != 0) && (!startsWith(engField(st, F_DRAWER()), "m:"))) {
                    if (pressX < DR_W()) {
                        if ((pressX >= 520.0) && (pressX < 592.0) && (pressY >= 24.0) && (pressY < 96.0)) {
                            drClosing = true
                            var sc: Bool = sfxPlay("close")
                            st = engSet(st, F_DRAWER(), "none")
                            objsDestroyTag("block")
                            sel = -1
                            renderBlocks(geo, n, -1)
                            objTextSet(label, "")
                        } else {
                        var sd: Bool = sfxPlay("click")
                        var s2: Str = drawerHit(m, st, pressX, pressY)
                        var d2: Str = engField(s2, F_DRAWER())
                        st = if (strCmp(d2, "pass") == 0) st else s2
                        if (strCmp(d2, "none") == 0) {
                            objsDestroyTag("block")
                            sel = -1
                            renderBlocks(geo, n, -1)
                            objTextSet(label, "")
                        } else null
                        if (startsWith(d2, "m:")) {
                            drClosing = false; drPairs = emptyList(); drX = 0.0; objsDestroyTag("drawer")
                            drawMoveHi(geo, n, geoSea, nSea, drawerNameOf(d2))
                            objTextSet(label, concat(concat("移动军队：点击高亮地块（", drawerNameOf(d2)), "）"))
                        } else null
                        }
                        consumed = true
                    } else null
                } else null
                    if (strCmp(ph, "events") == 0) { if (strCmp(engField(st, F_DRAWER()), "none") != 0) { objsDestroyTag("block"); sel = -1; renderBlocks(geo, n, -1); objTextSet(label, ""); drClosing = false; objsDestroyTag("drawer"); drPairs = emptyList(); drX = 0.0; st = engSet(st, F_DRAWER(), "none") } else null; st = engViewClick(m, st, pressX, pressY) }
                else {
                    if ((strCmp(engField(st, F_PANEL()), "none") == 0)
                        && (pressX >= AUTO_X()) && (pressX < (AUTO_X() + AUTO_S()))
                        && (pressY >= AUTO_Y()) && (pressY < (AUTO_Y() + AUTO_S()))) {
                        autoOn = !autoOn
                        var sa: Bool = sfxPlay("click")
                    consumed = true
                        autoAcc = 0.0
                        drawAutoBtn(autoOn)
                    } else null
                    var b: Nat = if (consumed) BTN_N() else whichBtn(pressX, pressY)
                    if (b < BTN_N()) {
                    if (strCmp(engField(st, F_DRAWER()), "none") != 0) { objsDestroyTag("block"); sel = -1; renderBlocks(geo, n, -1); objTextSet(label, ""); drClosing = false; objsDestroyTag("drawer"); drPairs = emptyList(); drX = 0.0; st = engSet(st, F_DRAWER(), "none") } else null
                        var kind: Str = btnKind(b)
                        if (strCmp(kind, engField(st, F_PANEL())) == 0) {
                            var sz: Bool = sfxPlay("close")
                            objsDestroyTag("panel")
                            st = engSet(st, F_PANEL(), "none")
                        } else {
                            var so: Bool = sfxPlay("click")
                            if (strCmp(kind, "ops") == 0) { st = engOpsOpen(m, st) }
                            else { st = renderPanelKind(m, st, kind) }
                        }
                    } else {
                        if ((strCmp(engField(st, F_PANEL()), "none") != 0) && panelBackHit(pressX, pressY)) {
                            var sb: Bool = sfxPlay("close")
                            objsDestroyTag("panel")
                            st = engSet(st, F_PANEL(), "none")
                        } else {
                            var pn: Str = engField(st, F_PANEL())
                            var sr: Bool = if (strCmp(pn, "none") != 0) sfxPlay("click") else false
                            if (strCmp(pn, "ops") == 0) { st = opsPanelHit(m, st, pressX, pressY) }
                            else {
                                if (strCmp(pn, "policy") == 0) { st = policyPanelHit(m, st, pressX, pressY) }
                                var pn2: Str = engField(st, F_PANEL())
                                if ((strCmp(pn2, "none") == 0) && (!consumed)) {
                                    @mut var wx: Rat = worldXOf(viewS, viewX, pressX)
                                    @mut var wy: Rat = worldYOf(viewS, viewY, pressY)
                                    @mut var seaHit: Bool = false
                                    @mut var hit: Int = mapHitProv(geo, wx, wy)
                                    if (hit < 0) {
                                        var hs: Int = mapHitProv(geoSea, wx, wy)
                                        if (hs >= 0) { hit = hs; seaHit = true } else null
                                    } else null
                                    var nm: Str = if (hit >= 0) (if (seaHit) mapProvName(geoSea, hit) else mapProvName(geo, hit)) else ""
                                    var dr0: Str = engField(st, F_DRAWER())
                                    if (startsWith(dr0, "m:")) {
                                        var src: Str = drawerNameOf(dr0)
                                        var nbs: List[Str] = adjNames(src)
                                        if ((strCmp(nm, "") != 0) && (strCmp(nm, src) != 0) && nameInList(nbs, 0, size(nbs), nm) && (!isSeaName(nm))) {
                                            st = drawerMoveOne(m, st, src, nm)
                                            drClosing = false; objsDestroyTag("drawer"); drPairs = emptyList(); drX = 0.0; st = engSet(st, F_DRAWER(), "none")
                                            objTextSet(label, "")
                                            var sm: Bool = sfxPlayMove()
                                        } else { if (strCmp(nm, "") != 0) { st = engSet(st, F_DRAWER(), nm); objTextSet(label, "") } else null }
                                    } else {
                                        if (strCmp(nm, "") != 0) { st = engSet(st, F_DRAWER(), nm); objTextSet(label, "") } else null
                                    }
                                    var dr1: Str = engField(st, F_DRAWER())
                                    if (startsWith(dr1, "m:")) {
                                        drClosing = false; drPairs = emptyList(); drX = 0.0; objsDestroyTag("drawer")
                                        if (!startsWith(dr0, "m:")) { drawMoveHi(geo, n, geoSea, nSea, drawerNameOf(dr1)) } else null
                                        if (!startsWith(dr0, "m:")) { objTextSet(label, concat(concat("移动军队：点击高亮地块（", drawerNameOf(dr1)), "）")) } else null
                                    } else {
                                        objsDestroyTag("movetarget")
                                        if (strCmp(dr1, "none") != 0) {
                                            if ((strCmp(dr0, dr1) != 0) || (pressX < DR_W())) { drClosing = false; objsDestroyTag("drawer"); drPairs = buildDrawer(m, st); drX = if (strCmp(dr0, "none") == 0) DR_OFF_X() else 0.0 } else null
                                        } else null
                                    }
                                    if ((strCmp(dr0, "none") != 0) && (strCmp(dr1, "none") == 0)) {
                                        objsDestroyTag("block")
                                        sel = -1
                                        renderBlocks(geo, n, -1)
                                        objTextSet(label, "")
                                        hit = -1
                                    } else null
                                    if ((hit >= 0) && (!seaHit) && (hit != sel)) {
                                        objsDestroyTag("block")
                                        sel = hit
                                        renderBlocks(geo, n, hit)
                                        if (!startsWith(dr1, "m:")) { objTextSet(label, concat("已选：", nm)) } else null
                                    } else null
                                } else null
                            }
                        }
                    }
                }
            }
        }
        pressed = false
        buildNav(m, engField(st, F_PANEL()))
    } }
    null
}

@impure
fun main(): Null {
    var lb: Bool = winWidth() >= winHeight()
    gameStartFit(1920, 1080, lb, false)
    sceneAdd("main") { _e => runSmoke() }
    sceneGo("main")
    null
}
