// main.subl —— 《深谋远虑》主控（foresight = 模组加载器：本体不做内容）
// 场景链路：mods 烘焙表（mods-data.subl）-> 叙事引擎（engine.subl 六段 tick 循环：
//   日期推进+资源产出 -> 玩家操作（操作面板 radio 组，行动点 2~4，用完自动结算，可不操作）
//   -> 事件触发（tick序数/条件/副线，事件/沉浸式/超事件按优先级）-> 玩家处理事件
//   -> 结算（效果+章末判定+dateJump 演出）-> 下一 tick）+ 地图三地块（entities.blocks 命名/归属）
//   + 顶栏日期/资源由引擎状态驱动 + 相机缩放/平移/点击选中。
// 状态串 st2（engine.subl）由本闭包 @mut 持有，各阶段模块级 @impure 函数进出串接。
// t84 解释器交付前，模组 logic/*.subl 只扫描进清单不执行（mods/README.md）。

// ---------- 画布与布局 ----------
fun VIEW_W(): Rat = 960.0
fun VIEW_H(): Rat = 540.0
fun LABEL_X(): Rat = 430.0

// ---------- 地图包围盒（世界像素；smoke-data.subl 三地块的极值） ----------
fun TX0(): Rat = 140.0
fun TX1(): Rat = 700.0
fun TY0(): Rat = 90.0
fun TY1(): Rat = 520.0
fun INIT_X(): Rat = ((TX0() + TX1()) / 2.0)
fun INIT_Y(): Rat = ((TY0() + TY1()) / 2.0)

// ---------- 颜色 ----------
fun COL_BG(): Str = "#101820"
fun COL_TITLE(): Str = "#F0F4F8"
fun COL_SUB(): Str = "#8FA3B8"
fun FILL_SEL(): Str = "#FFC107"
fun blockHex(i: Nat): Str =
    if (i == 0) "#4A6FA5"
    else (if (i == 1) "#6A8E5A" else "#A5785A")

// ---------- 相机（自由缩放；数学与 GameDemo 地图 demo 同构） ----------
fun CTR_X(): Rat = 480.0
fun CTR_Y(): Rat = 270.0
fun ZOOM_MIN(): Rat = 1.0
fun ZOOM_MAX(): Rat = 4.0
fun ZOOM_STEP(): Rat = 1.15
fun PAD(): Rat = 8.0
fun DRAG_THRESHOLD(): Rat = 8.0

fun visW(viewS: Rat): Rat = (VIEW_W() / viewS)
fun visH(viewS: Rat): Rat = (VIEW_H() / viewS)
fun panMinX(viewS: Rat): Rat = ((TX0() - PAD()) + (visW(viewS) / 2.0))
fun panMaxX(viewS: Rat): Rat = ((TX1() + PAD()) - (visW(viewS) / 2.0))
fun panMinY(viewS: Rat): Rat = ((TY0() - PAD()) + (visH(viewS) / 2.0))
fun panMaxY(viewS: Rat): Rat = ((TY1() + PAD()) - (visH(viewS) / 2.0))
fun clampS(v: Rat, lo: Rat, hi: Rat): Rat = if (v < lo) lo else (if (v > hi) hi else v)
fun clampP(v: Rat, lo: Rat, hi: Rat): Rat = if (lo > hi) ((lo + hi) / 2.0) else (if (v < lo) lo else (if (v > hi) hi else v))
fun distAbs(a: Rat, b: Rat): Rat = if (a > b) (a - b) else (b - a)
fun screenXOf(viewS: Rat, viewX: Rat, w: Rat): Rat = (((w - viewX) * viewS) + CTR_X())
fun screenYOf(viewS: Rat, viewY: Rat, w: Rat): Rat = (((w - viewY) * viewS) + CTR_Y())
fun worldXOf(viewS: Rat, viewX: Rat, s: Rat): Rat = (((s - CTR_X()) / viewS) + viewX)
fun worldYOf(viewS: Rat, viewY: Rat, s: Rat): Rat = (((s - CTR_Y()) / viewS) + viewY)
fun zoomViewXAt(viewS: Rat, viewX: Rat, wa: Rat, ns: Rat): Rat = (wa - ((screenXOf(viewS, viewX, wa) - CTR_X()) / ns))
fun zoomViewYAt(viewS: Rat, viewY: Rat, wa: Rat, ns: Rat): Rat = (wa - ((screenYOf(viewS, viewY, wa) - CTR_Y()) / ns))
fun panXOf(viewS: Rat, viewX: Rat, dx: Rat): Rat = clampP((viewX - (dx / viewS)), panMinX(viewS), panMaxX(viewS))
fun panYOf(viewS: Rat, viewY: Rat, dy: Rat): Rat = clampP((viewY - (dy / viewS)), panMinY(viewS), panMaxY(viewS))

// ---------- 通用 UI 组件（fixed 屏幕坐标 + z 分层；顶栏 10-12 / 底栏 10-12 / 面板 20 / 事件层 26-50） ----------
@impure
fun addRectT(w: Rat, h: Rat, x: Rat, y: Rat, hex: Str, tag: Str, z: Rat): Any {
    unchecked var o = objAdd()
    unchecked objUse(o, compPos(x, y))
    unchecked objUse(o, compRect(w, h))
    unchecked objUse(o, compColorHex(hex))
    unchecked objUse(o, compFixed())
    unchecked objUse(o, compZ(z))
    unchecked objTag(o, tag)
    return o
}
@impure
fun addTextT(t: Str, x: Rat, y: Rat, size: Rat, w: Nat, hex: Str, tag: Str, fixed: Bool, z: Rat): Any {
    unchecked var o = objAdd()
    unchecked objUse(o, compPos(x, y))
    unchecked objUse(o, compText(t, size, w))
    unchecked objUse(o, compColorHex(hex))
    unchecked if (fixed) { objUse(o, compFixed()); objUse(o, compZ(z)) }
    unchecked objTag(o, tag)
    return o
}

// ---------- 地图表：地块命名/归属来自模组 entities.blocks，几何来自 smoke-data ----------
@impure
fun blockCount(ent: Json): Nat = arrLen(jk(ent, "blocks"))
@impure
fun mapRowsLoop(ent: Json, n: Nat, i: Nat, acc: Str): Str =
    if (i >= n) acc
    else {
        var nm: Str = jstr(arrAt(jk(ent, "blocks"), i), "name")
        var row: Str = concat(concat(nm, ":"), geomOf(i))
        var sep: Str = if (i == 0) "" else "|"
        mapRowsLoop(ent, n, (i + 1), concat(concat(acc, sep), row))
    }
@impure
fun mapTableOf(ent: Json): Str = mapRowsLoop(ent, blockCount(ent), 0, "")

// ---------- 渲染 ----------
@impure
fun renderBlocksLoop(geo: Any, n: Nat, i: Nat, sel: Int): Null =
    if (i >= n) null
    else {
        var hex: Str = if (i == sel) FILL_SEL() else blockHex(i)
        var o: Any = mapProvObj(geo, i, hex)
        objTag(o, "block")
        renderBlocksLoop(geo, n, (i + 1), sel)
    }

@impure
fun renderBlocks(geo: Any, n: Nat, sel: Int): Null = renderBlocksLoop(geo, n, 0, sel)

@impure
fun applyView(viewS: Rat, viewX: Rat, viewY: Rat): Null {
    camPos(viewX, viewY)
    camScale(viewS, viewS)
    null
}

@impure
fun selectAt(geo: Any, n: Nat, label: Any, sel: Int, wx: Rat, wy: Rat): Int {
    var hit: Int = mapHitProv(geo, wx, wy)
    @mut var r: Int = sel
    if (hit >= 0) {
        if (hit != sel) {
            objsDestroyTag("block")
            r = hit
            renderBlocks(geo, n, hit)
            objTextSet(label, concat("已选：", mapProvName(geo, hit)))
        }
    }
    return r
}

// ---------- 主场景 ----------
@impure
fun runSmoke(): Null {
    var m: Json = activeMod()
    var md: Json = modMod(m)
    var ent: Json = modEnt(m)
    var geo: Any = mapLoad(mapTableOf(ent))
    var n: Nat = mapProvCount(geo)
    var bg: Any = rectAdd(((TX1() - TX0()) + (PAD() * 2.0)), ((TY1() - TY0()) + (PAD() * 2.0)), (TX0() - PAD()), (TY0() - PAD()), COL_BG())
    objTag(bg, "ui")
    @mut var sel: Int = -1
    @mut var st: Str = engInit(md, ent)
    buildTopbar(m, st)
    var label: Any = addTextT("", LABEL_X(), 28.0, 13.0, 400, COL_SUB(), "ui", true, 11.0)
    buildBottombar(m)
    @mut var viewS: Rat = 1.0
    @mut var viewX: Rat = INIT_X()
    @mut var viewY: Rat = INIT_Y()
    @mut var pressX: Rat = 0.0
    @mut var pressY: Rat = 0.0
    @mut var lastX: Rat = 0.0
    @mut var lastY: Rat = 0.0
    @mut var pressed: Bool = false
    @mut var moved: Bool = false
    renderBlocks(geo, n, -1)
    applyView(viewS, viewX, viewY)
    // 引擎起步：tick 1（相位1 日期推进+资源产出 -> 相位2 玩家操作阶段自动开操作面板）
    st = engTickStart(m, st)
    onScroll { dy =>
        var f: Rat = if (dy > 0.0) (1.0 / ZOOM_STEP()) else ZOOM_STEP()
        var gx: Rat = worldXOf(viewS, viewX, mousePosX())
        var gy: Rat = worldYOf(viewS, viewY, mousePosY())
        var ns: Rat = clampS((viewS * f), ZOOM_MIN(), ZOOM_MAX())
        if (ns != viewS) {
            viewX = zoomViewXAt(viewS, viewX, gx, ns)
            viewY = zoomViewYAt(viewS, viewY, gy, ns)
            viewX = panXOf(ns, viewX, 0.0)
            viewY = panYOf(ns, viewY, 0.0)
            viewS = ns
            applyView(ns, viewX, viewY)
        }
    }
    onMouseDown("left") { _e => if (!pressed) {
        pressed = true
        moved = false
        pressX = mousePosX()
        pressY = mousePosY()
        lastX = pressX
        lastY = pressY
    } }
    onMouseMove { _m => if (pressed) {
        var mx: Rat = mousePosX()
        var my: Rat = mousePosY()
        var dx: Rat = distAbs(mx, pressX)
        var dy3: Rat = distAbs(my, pressY)
        if ((!moved) && ((dx > DRAG_THRESHOLD()) || (dy3 > DRAG_THRESHOLD()))) { moved = true }
        if (moved) {
            viewX = panXOf(viewS, viewX, (mx - lastX))
            viewY = panYOf(viewS, viewY, (my - lastY))
            applyView(viewS, viewX, viewY)
        }
        lastX = mx
        lastY = my
    } }
    onMouseRelease("left") { _e => if (pressed) {
        if (!moved) {
            var ph: Str = engField(st, F_PHASE())
            if (strCmp(ph, "over") == 0) null
            else {
                if (strCmp(ph, "events") == 0) { st = engViewClick(m, st, pressX, pressY) }
                else {
                    var b: Nat = whichBtn(pressX, pressY)
                    if (b < BTN_N()) {
                        var kind: Str = btnKind(b)
                        if (strCmp(kind, engField(st, F_PANEL())) == 0) {
                            objsDestroyTag("panel")
                            st = engSet(st, F_PANEL(), "none")
                        } else {
                            if (strCmp(kind, "ops") == 0) { st = engOpsOpen(m, st) }
                            else { st = renderPanelKind(m, st, kind) }
                        }
                    } else {
                        var pn: Str = engField(st, F_PANEL())
                        if (strCmp(pn, "ops") == 0) { st = opsPanelHit(m, st, pressX, pressY) }
                        else {
                            if (strCmp(pn, "policy") == 0) { st = policyPanelHit(m, st, pressX, pressY) }
                            else { if (strCmp(pn, "none") == 0) { sel = selectAt(geo, n, label, sel, worldXOf(viewS, viewX, pressX), worldYOf(viewS, viewY, pressY)) } else null }
                        }
                    }
                }
            }
        }
        pressed = false
    } }
    null
}

@impure
fun main(): Null {
    var lb: Bool = winWidth() >= winHeight()
    gameStartFit(960, 540, lb, false)
    sceneAdd("main") { _e => runSmoke() }
    sceneGo("main")
    null
}
