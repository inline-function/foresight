// smoke-data.subl —— 演示地图几何常量（三地块：凹形/菱形/带洞，各验一项能力）
// 地块的「命名/归属」不由本文件给出——运行期由 mods 烘焙的 entities.blocks
// 驱动（mapTableOf 见 main.subl）：rows = 名称 + ":" + 环串。分隔符为 ASCII ":"。
// 本体自带三地块演示几何（凹形/菱形/带洞）；模组 blocks 多于三块时多出的用带洞默认几何。

fun GEOM_L(): Str = "140 110,300 110,300 200,220 200,220 300,140 300"
fun GEOM_D(): Str = "560 90,700 180,560 270,420 180"
fun GEOM_H(): Str = "180 400,480 400,480 520,180 520;260 430,400 430,400 490,260 490"

fun geomOf(i: Nat): Str =
    if (i == 0) GEOM_L()
    else (if (i == 1) GEOM_D() else GEOM_H())
